---
import Icon from '../chrome/Icon.astro';
interface Props { href: string; title: string; deck: string; }
const { href, title, deck } = Astro.props;
---
<a class="next-case" href={href}>
  <div class="label">Next case</div>
  <h3>{title}<span class="arrow"><Icon name="arrow-right" size={22} /></span></h3>
  <p class="deck">{deck}</p>
</a>
<style>
  /* ported from case-study-twilio.html .next-case, tokenized.
     Whole block is a single link for a generous click target. */
  .next-case {
    display: block;
    margin: var(--space-11) 0 0;
    padding: var(--space-9) 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .next-case .label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: var(--space-3);
  }
  .next-case h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-2);
    font-weight: 500;
    line-height: var(--lh-heading);
  }
  .next-case:hover h3 {
    color: var(--accent);
  }
  .next-case .arrow {
    display: inline-flex;
    align-items: center;
    vertical-align: -0.1em;
    color: var(--accent);
    margin-left: var(--space-2);
  }
  .next-case .deck {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-card);
    color: var(--ink-tertiary);
    margin: 0;
  }
</style>
