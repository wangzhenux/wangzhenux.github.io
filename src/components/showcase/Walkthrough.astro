---
/**
 * A walkthrough: the steps stay put on the left while the screen on the right
 * changes as the reader scrolls. On wide windows the motion island pins the
 * pair (list and screen) and swaps the screen every --wt-step of scroll, so a
 * 5-step flow takes about one screen of reading instead of five. Each step's
 * title also jumps to its screen. On phones and narrow windows the steps become
 * a swipe row: one card per step, its text above its screen, the next card
 * peeking in, and a dot per step under the row that follows the swipe.
 *
 * Without JS every step and every screen shows, stacked beside the sticky list
 * (on narrow windows the row still swipes; the dots wait for the island).
 * Under reduced motion the screens still follow the scroll, without the
 * crossfade, and a dot jumps to its card without the glide. Screens are
 * zoomable (lightbox island). Token-only CSS.
 *
 *   <Walkthrough id="mk-steps" label="Marketing today, in 5 steps"
 *     steps={[{ eyebrow: 'AI', title: '…', body: '…', image: '/…', imageAlt: '…', width: 2400, height: 1500 }]} />
 */
interface Step {
  eyebrow?: string;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  width: number;
  height: number;
}
interface Props {
  id: string;
  label: string;
  steps: Step[];
}
const { id, label, steps } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="wt" id={id} data-wt aria-label={label} role="group" style={`--wt-n: ${steps.length}`}>
  <div class="wt-stage">
    <ol class="wt-steps">
      {steps.map((s, i) => (
        <li class:list={['wt-step', { 'is-active': i === 0 }]} data-i={i} style={`--col: ${i + 1}`}>
          <p class="wt-k">
            <span class="wt-num">{pad(i + 1)}</span>
            {s.eyebrow && <span class="wt-eyebrow">{s.eyebrow}</span>}
          </p>
          <h4 class="wt-title"><a class="wt-link" href={`#${id}-${i + 1}`}>{s.title}</a></h4>
          <div class="wt-body"><p>{s.body}</p></div>
        </li>
      ))}
    </ol>
    <div class="wt-screens">
      {steps.map((s, i) => (
        <figure class:list={['wt-fig', { 'is-active': i === 0 }]} id={`${id}-${i + 1}`} data-i={i} data-zoomable style={`--col: ${i + 1}`}>
          <img src={s.image} alt={s.imageAlt} width={s.width} height={s.height} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </div>
  <ol class="wt-dots">
    {steps.map((_, i) => (
      <li>
        <button class="wt-dot" type="button" aria-label={`Step ${i + 1} of ${steps.length}`} aria-current={i === 0 ? 'true' : 'false'}></button>
      </li>
    ))}
  </ol>
</div>
<style>
  .wt {
    --wt-step: 220px;
    margin: var(--space-7) 0 var(--space-9);
  }
  .wt-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-9);
    align-items: start;
  }
  .wt-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: sticky;
    top: var(--space-13);
    display: grid;
    gap: var(--space-1);
  }
  .wt-step {
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-left: 2px solid var(--rule);
    transition: border-color 0.3s ease;
  }
  .wt-k {
    margin: 0 0 var(--space-1);
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .wt-eyebrow { color: var(--accent-ink); }
  /* The step title leads (large-card serif); its text is a quieter caption:
     smaller, lighter and a little apart, so the 2 never read as one size. */
  .wt-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: var(--lh-title);
    color: var(--ink-primary);
    transition: color 0.3s ease;
  }
  .wt-link { color: inherit; text-decoration: none; }
  .wt-link:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .wt-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }
  .wt-body p {
    margin: 0;
    padding-top: var(--space-3);
    overflow: hidden;
    min-height: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-card);
    color: var(--ink-tertiary);
  }
  .wt-screens { display: grid; gap: var(--space-9); }
  .wt-fig { margin: 0; scroll-margin-top: var(--space-13); }
  .wt-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--rule);
  }

  /* Armed by the motion island: only the active step is open and inked. */
  .wt.is-armed .wt-step:not(.is-active) .wt-title { color: var(--ink-tertiary); }
  .wt.is-armed .wt-step:not(.is-active) .wt-body { grid-template-rows: 0fr; opacity: 0; }
  .wt.is-armed .wt-step.is-active { border-left-color: var(--accent); }

  /* Staged (wide windows, armed): the pair is pinned mid-window and the screens
     share one spot, so scrolling swaps them in place. The block is as tall as
     the stage plus one --wt-step of scroll per extra step. */
  @media (min-width: 960px) {
    .wt.is-staged { height: calc(var(--wt-stage-h, 480px) + (var(--wt-n) - 1) * var(--wt-step)); }
    .wt.is-staged .wt-stage {
      position: sticky;
      top: max(var(--space-13), calc(50vh - var(--wt-stage-h, 480px) / 2));
      align-items: center;
    }
    .wt.is-staged .wt-steps { position: static; }
    .wt.is-staged .wt-screens { gap: 0; }
    .wt.is-staged .wt-fig {
      grid-area: 1 / 1;
      align-self: center;
      opacity: 0;
      transform: translateY(var(--space-2));
      transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
      pointer-events: none;
    }
    .wt.is-staged .wt-fig.is-active { opacity: 1; transform: none; pointer-events: auto; }
  }

  /* Dots under the swipe row, one per card, in the look of the site's other
     carousel dots; the current card's dot is a filled pill. Hidden on wide
     windows, and until the motion island arms the walkthrough. Each dot's tap
     area reaches past the 8px dot. */
  .wt-dots {
    display: none;
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    justify-content: center;
    gap: var(--space-2);
  }
  .wt-dots li { display: flex; }
  .wt-dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--rule);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .wt-dot::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--space-2)) calc(-1 * var(--space-1));
  }
  .wt-dot[aria-current="true"] { width: 30px; background: var(--accent); }

  /* Narrow: a swipe row, one card per step. The two lists dissolve into one
     grid where a step and its screen share a column (the inline --col): text in
     row 1, screen in row 2, so row 1 is as tall as the longest text and every
     screen starts on the same line. A card is 86% of the row, so the next one
     peeks in. The row reaches 4px into the page margin on each side, padded
     back in, so the scroller doesn't clip a screen's hairline edge or a title's
     focus ring. */
  @media (max-width: 959px) {
    .wt-stage {
      grid-template-columns: none;
      grid-template-rows: auto auto;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      gap: var(--space-4) var(--space-5);
      margin-inline: calc(-1 * var(--space-1));
      padding: 0 var(--space-1) var(--space-1);
      scroll-padding-inline: var(--space-1);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .wt-stage::-webkit-scrollbar { display: none; }
    .wt-steps, .wt-screens { display: contents; }
    .wt-step { grid-column: var(--col); grid-row: 1; padding: 0; border: 0; scroll-snap-align: start; }
    .wt-fig { grid-column: var(--col); grid-row: 2; }
    .wt.is-armed .wt-step:not(.is-active) .wt-title { color: var(--ink-primary); }
    .wt.is-armed .wt-step:not(.is-active) .wt-body { grid-template-rows: 1fr; opacity: 1; }
    .wt.is-armed .wt-dots { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wt-step, .wt-title, .wt-body, .wt-fig, .wt-dot { transition: none; }
  }
</style>
