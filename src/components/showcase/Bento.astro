---
/**
 * A reusable Apple-style bento grid for a set of short, scannable points. One
 * `hero` card spans 2×2, `wide` cards span two columns, the rest are 1×1, packed
 * with `grid-auto-flow: dense`. Each card leads with a VISUAL — a real screenshot
 * (`image`) or a labelled placeholder you swap later (`visual`) — then a punchy
 * title + a one-line body.
 *
 * Breaks out to the full content width (like <ImageShowcase>); the optional
 * heading + deck live inside the same full-width frame, so the whole section is
 * one width. The sticky TOC fades while it's in view (its band class `.bento` is
 * in the toc-scrollspy showcase observer). Token-only CSS.
 *
 *   <Bento heading="…" deck="…" items={[{ title, body, visual, size: 'hero' }, …]} />
 */
interface BentoItem {
  title: string;
  body?: string;
  /** Hint for the placeholder until a real screenshot is supplied. */
  visual?: string;
  /** Real screenshot src (public path). When set, replaces the placeholder. */
  image?: string;
  imageAlt?: string;
  /** Footprint. Default is a 1×1 cell. */
  size?: 'hero' | 'wide';
  /** Icon-led card (no visual slot) — a small accent glyph above the title. Used
   *  for a feature/context bento; ignored when `image` or `visual` is present. */
  icon?: string;
  /** `crop` mode only: object-position for the cover crop (e.g. "center top",
   *  "left center"), controlling which region of the screenshot is shown. */
  pos?: string;
  /** `crop` mode only: exact Figma-style crop transform — the image is sized
   *  and offset in PERCENTAGES of the tile (w/h = image size, left/top = image
   *  offset, negatives shift the image out of frame). Takes precedence over
   *  `pos`; lets a tile show the precise region a design specifies. */
  frame?: { w: number; h: number; left: number; top: number };
}
interface Props {
  items: BentoItem[];
  /** Accessible name for the grid region. Section/sub-section TITLES are not set here —
   *  precede the <Bento> with <PartHeader> or <SectionH small> (see DESIGN.md §5). */
  label?: string;
  /** Full-bleed images (run to the card edges) instead of the default framed/padded
   *  look. Use for illustrations whose own background matches the card surface. */
  bleed?: boolean;
  /** Crop-to-fill: each tile gets a fixed aspect and the image covers it (cropped),
   *  filling the card edge-to-edge — for real product screenshots shown as focused
   *  crops (à la a high-density feature grid). Per-item `pos` picks the crop region.
   *  Implies `bleed`. */
  crop?: boolean;
}
const { items, label = 'Highlights', bleed = false, crop = false } = Astro.props;
const glyph =
  '<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="6" y="10" width="36" height="28" rx="3" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="20" r="3" stroke="currentColor" stroke-width="2"/><path d="M9 35 L20 25 L27 31 L34 25 L39 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

// Line-icon set for icon-led cards (a small accent glyph above the title).
const SI =
  '" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>';
const icons: Record<string, string> = {
  chat: `<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-4 3v-3H4z${SI}<path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01${SI}</svg>`,
  intake: `<svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2${SI}<path d="M9 8h6M9 12h6M9 16h3${SI}</svg>`,
  pin: `<svg viewBox="0 0 24 24"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z${SI}<circle cx="12" cy="10" r="2.5${SI}</svg>`,
  calendar: `<svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="16" rx="2${SI}<path d="M4 9.5h16M8 3v4M16 3v4${SI}<path d="M9 14.5l1.6 1.6L14 12.5${SI}</svg>`,
  user: `<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5${SI}<path d="M5 20a7 7 0 0 1 14 0${SI}</svg>`,
  link: `<svg viewBox="0 0 24 24"><path d="M9 15l6-6${SI}<path d="M11 6l1.2-1.2a4 4 0 0 1 5.6 5.6L16.6 12${SI}<path d="M13 18l-1.2 1.2a4 4 0 0 1-5.6-5.6L7.4 12${SI}</svg>`,
  spark: `<svg viewBox="0 0 24 24"><path d="M12 4l1.7 4.7L18 11l-4.3 1.6L12 18l-1.7-5.4L6 11l4.3-2.3z${SI}</svg>`,
};
---
<section class:list={['bento', bleed && 'bento--bleed', crop && 'bento--crop']} aria-label={label}>
  <div class="bento-inner">
    <ul class="bento-grid">
      {items.map((it) => (
        <li class:list={['bento-card', it.size && `bento-card--${it.size}`, !it.image && !it.visual && it.icon && 'bento-card--icon']}>
          {(it.image || it.visual) && (
            <div class="bento-visual">
              {it.image ? (
                <img
                  class:list={['bento-img', crop && it.frame && 'bento-img--framed']}
                  src={it.image}
                  alt={it.imageAlt ?? it.visual ?? it.title}
                  loading="lazy"
                  decoding="async"
                  style={
                    crop && it.frame
                      ? `width: ${it.frame.w}%; height: ${it.frame.h}%; left: ${it.frame.left}%; top: ${it.frame.top}%;`
                      : crop && it.pos
                        ? `object-position: ${it.pos}`
                        : undefined
                  }
                />
              ) : (
                <div class="bento-ph" role="img" aria-label={`Placeholder — ${it.visual ?? it.title}`}>
                  <span class="bento-ph-glyph" set:html={glyph} />
                  {it.visual && <span class="bento-ph-label">{it.visual}</span>}
                </div>
              )}
            </div>
          )}
          <div class="bento-text">
            {!it.image && !it.visual && it.icon && icons[it.icon] && (
              <span class="bento-iconmark" aria-hidden="true" set:html={icons[it.icon]} />
            )}
            <h3 class="bento-title">{it.title}</h3>
            {it.body && <p class="bento-body">{it.body}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  /* Full-bleed breakout (same math as <ImageShowcase>); the inner frame caps at
     the content width and left-aligns with the reading column. */
  .bento {
    position: relative;
    width: calc(100vw - var(--sbw));
    margin-inline: calc(50% - (100vw - var(--sbw)) / 2);
    /* Top margin hugs the preceding heading (the cards float on the page — no tinted
       band to fill a large gap): ~32px under a SectionH small, and the PartHeader's
       own 40px bottom margin governs when a bento opens a Part. Bottom keeps section
       separation. */
    margin-block: var(--space-7) var(--space-9);
  }
  .bento-inner {
    max-width: var(--max-content);
    margin-inline: auto;
    padding-inline: var(--pad-page-x);
  }


  .bento-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto;
    grid-auto-flow: row dense;
    gap: var(--space-4);
  }
  .bento-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow: hidden;
    background: var(--bg-secondary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .bento-card--wide { grid-column: span 2; }
  /* No colored wash on the hero — its 2×2 scale carries the hierarchy; terracotta
     stays an accent, not a background. */
  .bento-card--hero {
    grid-column: span 2;
    grid-row: span 2;
    padding: var(--space-5);
  }

  .bento-visual {
    border-radius: var(--radius);
    overflow: hidden;
  }
  /* The image fills its cell width at its OWN aspect ratio (height follows) — no crop,
     no letterbox; the cell sizes to the image. By default the card pads the image (a
     framed look); pass `bleed` for full-bleed images (see .bento--bleed below). */
  .bento-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .bento-ph {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-3);
    background: var(--bg-primary);
    border: 1px dashed var(--rule);
    border-radius: var(--radius);
  }
  .bento-card--hero .bento-ph { background: var(--bg-primary); }
  .bento-ph-glyph {
    display: block;
    width: 30px;
    height: 30px;
    color: var(--ink-tertiary);
    opacity: 0.7;
  }
  .bento-ph-glyph :global(svg) { width: 100%; height: 100%; }
  .bento-ph-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    color: var(--ink-tertiary);
    max-width: 24ch;
  }
  .bento-card--hero .bento-ph-glyph { width: 38px; height: 38px; }
  .bento-card--hero .bento-ph-label { font-size: 11px; }

  .bento-text { flex: none; }
  /* Icon-led cards (context/feature bento) have no visual slot — a small accent
     glyph sits above the title; the card breathes from the top. */
  .bento-iconmark {
    display: block;
    width: 26px;
    height: 26px;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .bento-iconmark :global(svg) { width: 100%; height: 100%; display: block; }
  .bento-card--hero .bento-iconmark { width: 34px; height: 34px; margin-bottom: var(--space-4); }
  .bento-title {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    margin: 0 0 var(--space-1);
    font-weight: 500;
  }
  .bento-card--hero .bento-title { font-size: 23px; margin-bottom: var(--space-2); }
  .bento-body {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-secondary);
    margin: 0;
  }
  .bento-card--hero .bento-body { font-size: 15px; line-height: 1.55; }

  /* Bleed variant — the image runs edge-to-edge to the card border (no padding around
     it); the card's overflow:hidden + radius clips its top corners, and only the text
     is padded. For full-bleed illustrations whose own background matches the card. */
  .bento--bleed .bento-card { gap: 0; padding: 0; }
  .bento--bleed .bento-card--hero { padding: 0; }
  .bento--bleed .bento-visual { border-radius: 0; }
  .bento--bleed .bento-text { padding: var(--space-4); }
  .bento--bleed .bento-card--hero .bento-text { padding: var(--space-5); }

  /* Crop mode, matching the Figma bento (node 1605-15955) exactly: a warm
     near-white card (lighter than the page) holds a fixed-aspect image whose
     bottom FADES into the card via a gradient, with the title in a strip
     below. Hero image is 1:1; small images ≈1.1:1. Each image is positioned
     with the design's percent transforms (`frame`) so the visible region is
     the one the design specifies. */
  .bento--crop .bento-card {
    gap: 0;
    padding: 1px;
    background: var(--bento-card-bg);
  }
  .bento--crop .bento-visual {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 10 / 9;
    border-radius: 0;
  }
  .bento--crop .bento-card--hero .bento-visual { aspect-ratio: 1 / 1; }
  .bento--crop .bento-card--wide .bento-visual { aspect-ratio: 16 / 9; }
  .bento--crop .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Figma-framed image: absolutely positioned by the per-item percent
     transform (inline style); max-width unlocked so w>100% can overflow.
     `cover` (not `fill`) keeps the image's own aspect ratio, so when a card's
     aspect changes responsively — e.g. the hero flips to 16/9 below 900px — the
     screenshot crops instead of stretching. The frame percentages are authored
     so the box matches the image aspect at the design size, where cover ≡ fill. */
  .bento--crop .bento-img--framed {
    position: absolute;
    max-width: none;
    object-fit: cover;
  }
  /* The image dissolves into the card surface just above the title strip. */
  .bento--crop .bento-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bento-img-fade);
    pointer-events: none;
  }
  /* Title strip below the image, on the card surface. */
  .bento--crop .bento-text { padding: var(--space-4); }
  .bento--crop .bento-card--hero .bento-text { padding: var(--space-5) var(--space-5) var(--space-7); }
  .bento--crop .bento-title { font-size: 20px; line-height: 1.4; }
  .bento--crop .bento-card--hero .bento-title { font-size: 23px; line-height: 1.22; }
  @media (max-width: 900px) {
    /* When the hero collapses to 1 row (tablet), widen its crop so it doesn't
       tower over the small tiles. */
    .bento--crop .bento-card--hero .bento-visual { aspect-ratio: 16 / 9; }
  }

  /* Tablet: 2 columns. Cards stay content-sized; images keep their natural ratio. */
  @media (max-width: 900px) {
    .bento-grid { grid-template-columns: repeat(2, 1fr); }
    .bento-card--hero { grid-column: span 2; grid-row: span 1; }
    .bento-card--wide { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .bento-grid { grid-template-columns: 1fr; }
    .bento-card--hero,
    .bento-card--wide { grid-column: span 1; }
  }
</style>
