---
// Reserved for actual design artifacts (user flow, phase mockups). The whole
// band breaks out to the FULL VIEWPORT WIDTH so artifacts are shown large, on
// the dotted grid. The image fits within the gutter container at its natural
// aspect ratio (width:100%, height:auto) — never cropped. The sticky TOC fades
// out while a showcase is in view (§8.3), so spanning full width is clean.
//
// Full-bleed is anchored to the viewport via position:fixed-style left math:
// left:50% positions the band's left edge at the centre of its containing
// block, then translateX(-50vw) pulls it to the true viewport-left. This is
// robust even though the body column is offset (TOC to its right), because the
// translate is in viewport units, not relative to the (off-centre) parent.
//
// variant="wireframe" / "wireframe-dark": the same band in the stage tones, for
// wireframes and other mostly-white or transparent design artifacts. Pick the
// tone the image was drawn for (light labels → dark).
interface Props {
  variant?: 'default' | 'wireframe' | 'wireframe-dark';
}
const { variant = 'default' } = Astro.props;
---
<div class:list={['image-showcase', variant !== 'default' && `image-showcase--${variant}`]}>
  <div class="showcase-inner" data-zoomable><slot /></div>
</div>
<style>
  .image-showcase {
    position: relative;
    width: calc(100vw - var(--sbw));
    padding-block: var(--space-9);
    /* Span the content area exactly (viewport minus the scrollbar), centered, so the
       band never overflows past the content edges. --sbw is measured in BaseLayout. */
    margin-inline: calc(50% - (100vw - var(--sbw)) / 2);
  }
  /* At >=1080px the frame is centred (max-content). The body column's LEFT edge
     is fixed at the frame content-left (50vw - max-content/2 + gutter) no matter
     how wide the sticky TOC is, so we can anchor the full-bleed band to the true
     viewport edge with the frame tokens. The TOC fades out while a showcase is in
     view (§8.3), so spanning the full width doesn't collide with it. */
  .image-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--bg-secondary);
    background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
    background-size: 28px 28px;
    z-index: 0;
  }
  .image-showcase--wireframe::before {
    background-color: var(--stage-bg);
    background-image: radial-gradient(circle, var(--stage-dot) 1px, transparent 1.5px);
  }
  .image-showcase--wireframe-dark::before {
    background-color: var(--stage-bg-dark);
    background-image: radial-gradient(circle, var(--stage-dot-dark) 1px, transparent 1.5px);
  }
  .showcase-inner {
    position: relative;
    z-index: 1;
    /* Image floats on the grid with clear breathing room: capped below the
       band width and inset by a generous gutter, so the dotted grid frames it
       on all sides. */
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: var(--space-12);
  }
  @media (max-width: 767px) {
    .showcase-inner { padding-inline: var(--pad-page-x); }
  }
  /* Image fits its container at natural aspect ratio — never cropped. */
  .showcase-inner :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    border-radius: var(--radius-lg);
    cursor: zoom-in;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .showcase-inner :global(img:hover) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }
  /* Wireframes are mostly transparent: outline the drawn shapes, not the box. */
  .image-showcase--wireframe .showcase-inner :global(img) {
    filter: var(--wire-edge);
  }
  .image-showcase--wireframe .showcase-inner :global(img:hover),
  .image-showcase--wireframe-dark .showcase-inner :global(img:hover) {
    box-shadow: none;
  }
</style>
