---
/**
 * EXAMPLE VISUAL — a row of small schematic sketches, built from tokens, for
 * showing several concept DIRECTIONS explored during early exploration (not
 * literal screenshots — real early-stage mockups are rarely clean/complete
 * enough to reproduce faithfully). Each tile pairs a tiny illustrative SVG
 * with a label + one-line note.
 *
 *   <ConceptSketches
 *     eyebrow="Visualization directions we explored"
 *     items={[{ kind: 'sankey', label: 'Sankey flow', note: '…' }, …]}
 *   />
 *
 * `kind` selects a built-in sketch: 'sankey' | 'orbital' | 'network' | 'bars'.
 */
interface Item {
  kind: 'sankey' | 'orbital' | 'network' | 'bars';
  label: string;
  note?: string;
}
interface Props {
  eyebrow: string;
  items: Item[];
}
const { eyebrow, items } = Astro.props;

const sketches: Record<Item['kind'], string> = {
  sankey: `<svg viewBox="0 0 200 120" aria-hidden="true">
    <rect x="8" y="14" width="7" height="26" fill="var(--ink-tertiary)"/>
    <rect x="8" y="48" width="7" height="18" fill="var(--ink-tertiary)"/>
    <rect x="8" y="74" width="7" height="32" fill="var(--ink-tertiary)"/>
    <rect x="185" y="18" width="7" height="48" fill="var(--accent)"/>
    <rect x="185" y="74" width="7" height="28" fill="var(--ink-tertiary)"/>
    <path d="M15 27 C 95 27, 110 38, 185 40" stroke="var(--accent)" stroke-width="15" fill="none" opacity="0.32" stroke-linecap="butt"/>
    <path d="M15 57 C 95 57, 110 44, 185 44" stroke="var(--ink-quaternary)" stroke-width="9" fill="none" opacity="0.55" stroke-linecap="butt"/>
    <path d="M15 90 C 95 90, 110 88, 185 88" stroke="var(--ink-quaternary)" stroke-width="17" fill="none" opacity="0.4" stroke-linecap="butt"/>
  </svg>`,
  orbital: `<svg viewBox="0 0 200 120" aria-hidden="true">
    <circle cx="100" cy="60" r="46" fill="none" stroke="var(--rule)"/>
    <circle cx="100" cy="60" r="30" fill="none" stroke="var(--rule)"/>
    <circle cx="100" cy="60" r="9" fill="var(--accent)"/>
    <!-- nodes sit exactly on their orbit (center 100,60): inner ring r=30, outer ring r=46 -->
    <circle cx="130" cy="60" r="4.5" fill="var(--ink-tertiary)"/>
    <circle cx="80.7" cy="83" r="5.5" fill="var(--accent-ink)"/>
    <circle cx="73.6" cy="22.3" r="4" fill="var(--ink-tertiary)"/>
    <circle cx="141.7" cy="40.6" r="3.5" fill="var(--ink-quaternary)"/>
    <circle cx="55.6" cy="48.1" r="3" fill="var(--ink-quaternary)"/>
  </svg>`,
  network: `<svg viewBox="0 0 200 120" aria-hidden="true">
    <line x1="38" y1="28" x2="92" y2="60" stroke="var(--rule)"/>
    <line x1="92" y1="60" x2="152" y2="34" stroke="var(--rule)"/>
    <line x1="92" y1="60" x2="122" y2="96" stroke="var(--rule)"/>
    <line x1="92" y1="60" x2="44" y2="90" stroke="var(--rule)"/>
    <line x1="152" y1="34" x2="176" y2="70" stroke="var(--rule)"/>
    <circle cx="38" cy="28" r="5" fill="var(--ink-tertiary)"/>
    <circle cx="92" cy="60" r="10" fill="var(--accent)"/>
    <circle cx="152" cy="34" r="5" fill="var(--ink-tertiary)"/>
    <circle cx="122" cy="96" r="4" fill="var(--ink-quaternary)"/>
    <circle cx="44" cy="90" r="4" fill="var(--ink-quaternary)"/>
    <circle cx="176" cy="70" r="3.5" fill="var(--accent-ink)"/>
  </svg>`,
  bars: `<svg viewBox="0 0 200 120" aria-hidden="true">
    <rect x="16" y="60" width="20" height="46" fill="var(--ink-quaternary)"/>
    <rect x="46" y="38" width="20" height="68" fill="var(--ink-tertiary)"/>
    <rect x="76" y="70" width="20" height="36" fill="var(--ink-quaternary)"/>
    <rect x="106" y="20" width="20" height="86" fill="var(--accent)"/>
    <rect x="136" y="52" width="20" height="54" fill="var(--ink-tertiary)"/>
    <rect x="166" y="66" width="20" height="40" fill="var(--ink-quaternary)"/>
    <line x1="10" y1="106" x2="192" y2="106" stroke="var(--rule)"/>
  </svg>`,
};
---
<figure class="cs">
  <figcaption class="cs-eyebrow">{eyebrow}</figcaption>
  <div class="cs-grid">
    {items.map((it) => (
      <div class="cs-tile">
        <div class="cs-art" set:html={sketches[it.kind]} />
        <p class="cs-label">{it.label}</p>
        {it.note && <p class="cs-note">{it.note}</p>}
      </div>
    ))}
  </div>
</figure>
<style>
  .cs {
    margin: var(--space-8) 0;
  }
  .cs-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-tertiary);
    margin-bottom: var(--space-5);
  }
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .cs-tile {
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .cs-art {
    aspect-ratio: 200 / 120;
    display: block;
  }
  .cs-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cs-label {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-primary);
    margin: var(--space-4) 0 0;
  }
  .cs-note {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-tertiary);
    margin: var(--space-1) 0 0;
  }
  @media (max-width: 767px) {
    .cs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
