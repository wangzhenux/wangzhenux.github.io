---
// Two-column "What I learned" grid. Children are ReflectionCards.
---
<div class="reflection"><slot /></div>
<style>
  /* ported from case-study-twilio.html .reflection, tokenized. */
  .reflection {
    margin: var(--space-11) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
  }
  /* Reflection stacks on mobile (§9.1). */
  @media (max-width: 767px) {
    .reflection { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
