---
/**
 * A numbered "Part" header — the spine of a card-forward case study. A hairline
 * rule, an accent "Part 0N" eyebrow, and a large display title. Use one per Part.
 * Pass `kicker` to relabel the eyebrow (e.g. "Context") and omit `num`.
 *
 *   <PartHeader num="01" title="The problem" />
 *   <PartHeader kicker="Context" title="What we shipped" />
 */
interface Props {
  num?: string;
  title: string;
  kicker?: string;
  /** Drop the top hairline rule + tighten the top margin. Use on the FIRST part,
   *  where the hero/meta strip already provides a divider — avoids a redundant
   *  double rule across the hero→body transition. */
  noRule?: boolean;
}
const { num, title, kicker = 'Part', noRule = false } = Astro.props;
---
<header class:list={['part', noRule && 'part--flush']}>
  <span class="part-eyebrow">
    <span class="part-dot" aria-hidden="true"></span>{kicker}{num ? ` ${num}` : ''}
  </span>
  <h2 class="part-title">{title}</h2>
</header>
<style>
  .part {
    margin: var(--space-13) 0 var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }
  /* First part: no top rule (the hero already divides), tighter top margin. */
  .part--flush {
    margin-top: var(--space-9);
    padding-top: 0;
    border-top: none;
  }
  .part-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .part-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .part-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    margin: 0;
    font-weight: 500;
    /* No width cap: the title fills the content column, so short phrases stay
       on one line. Long titles still wrap naturally at the column edge. */
    text-wrap: balance;
  }
</style>
