---
interface StripItem {
  /** Short title of the work. */
  label: string;
  /** One-line description of scope. */
  detail: string;
  /** Optional link to a standalone page. */
  href?: string;
  /** Optional status chip, e.g. "in progress". */
  status?: string;
}
interface Props {
  items: StripItem[];
  heading?: string;
}
const { items, heading = 'Selected work' } = Astro.props;
---
<section class="strip" aria-labelledby="strip-heading">
  <h2 class="strip-h2" id="strip-heading">{heading}</h2>
  <ul class="strip-list">
    {items.map((it) => (
      <li class="strip-item">
        <span class="strip-label">
          {it.href ? <a class="strip-link" href={it.href}>{it.label}</a> : it.label}
          {it.status && <span class="strip-tag">{it.status}</span>}
        </span>
        <span class="strip-detail">{it.detail}</span>
      </li>
    ))}
  </ul>
</section>
<style>
  .strip {
    margin-top: var(--space-11);
    padding-top: var(--space-9);
    border-top: 1px solid var(--rule);
  }
  .strip-h2 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-6);
    font-weight: 500;
  }
  .strip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-soft);
  }
  .strip-item {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-4) var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule-soft);
    align-items: baseline;
  }
  .strip-label {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink-primary);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .strip-link {
    color: var(--ink-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .strip-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .strip-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
    white-space: nowrap;
  }
  .strip-detail {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  @media (max-width: 600px) {
    .strip-item { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
