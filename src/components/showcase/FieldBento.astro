---
/**
 * A 4×3 bento of product windows on coloured tiles. One contour-line field
 * (`field`, an SVG of lines on transparent) is laid over the whole grid and
 * sliced per tile, so the pattern runs continuously across tiles while each
 * tile tints it in its own colour (emerald or mint). Titles are live text, top left; each window
 * is a transparent PNG anchored bottom right and cut flush at those edges.
 *
 * Tile geometry follows the design the windows were drawn for: `cols` × `rows`
 * cells, each row `ratio` × a column tall, so window positions hold at any
 * width. `wide` lets the grid run past the text column, up to 1200px. A tile
 * without an image is a type tile: an eyebrow, one big line and a few chips.
 * On wide, short tiles `copy` narrows the title to a left column. Below
 * 1120px the tiles stack in one column (capped at 560px so the windows stay
 * sharp) and each window sits under its title.
 * Token-only CSS.
 *
 *   <FieldBento wide cols={5} field="/…/field.svg" items={[{ title, sub, image, alt, width,
 *     height, tone: 'emerald', col: 1, row: 1, cols: 2, rows: 2, win: 97.7 }, …]} />
 */
interface Tile {
  title?: string;
  sub?: string;
  image?: string;
  alt?: string;
  /** Intrinsic size of the window PNG. */
  width?: number;
  height?: number;
  /** Type tile (no image): small label, one big line, and chips. */
  eyebrow?: string;
  big?: string;
  chips?: string[];
  /** Title column width as a % of the tile (for wide, short tiles). */
  copy?: number;
  tone: 'emerald' | 'mint';
  /** 1-based grid start and span on the desktop grid (`cols` × 3). */
  col: number;
  row: number;
  cols?: number;
  rows?: number;
  /** Window width as a % of the tile width (desktop). */
  win?: number;
  /** Stacked layout: window width as a % of the tile, and its max height. */
  mw?: number;
  mh?: number;
}
interface Props {
  items: Tile[];
  field: string;
  label?: string;
  cols?: number;
  rows?: number;
  /** Row height as a fraction of the column width. */
  ratio?: number;
  wide?: boolean;
}
const { items, field, label = 'Highlights', cols = 4, rows = 3, ratio = 290 / 258, wide = false } = Astro.props;
---
<section class:list={['fb', { 'fb--wide': wide }]} aria-label={label} style={`--field: url(${field}); --n: ${cols}; --m: ${rows}; --ratio: ${ratio}`}>
  <div class="fb-inner">
    <ul class="fb-grid">
      {items.map((it, i) => (
        <li
          class:list={['fb-tile', `fb-tile--${it.tone}`, { 'fb-tile--type': !it.image }]}
          style={`grid-column:${it.col} / span ${it.cols ?? 1};grid-row:${it.row} / span ${it.rows ?? 1};--c:${it.col - 1};--r:${it.row - 1};--win:${it.win ?? 90}%;--mw:${it.mw ?? 90}%;--mh:${it.mh ?? 260}px;--copy:${it.copy ?? 100}%;--i:${i}`}
        >
          {it.image ? (
            <>
              <div class="fb-copy">
                <h3 class="fb-title">{it.title}</h3>
                {it.sub && <p class="fb-sub">{it.sub}</p>}
              </div>
              <img class="fb-win" src={it.image} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
            </>
          ) : (
            <div class="fb-type">
              {it.eyebrow && <p class="fb-eyebrow">{it.eyebrow}</p>}
              {it.big && <p class="fb-big">{it.big}</p>}
              {it.chips && (
                <ul class="fb-chips">{it.chips.map((c) => <li>{c}</li>)}</ul>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .fb {
    width: calc(100vw - var(--sbw));
    margin: var(--space-9) calc(50% - (100vw - var(--sbw)) / 2);
  }
  .fb-inner {
    max-width: var(--max-content);
    margin-inline: auto;
    padding-inline: var(--pad-page-x);
    container-type: inline-size;
  }
  .fb--wide .fb-inner { max-width: calc(1200px + 2 * var(--pad-page-x)); }
  .fb-grid {
    --g: var(--space-4);
    /* Column and row size from the container width; rows keep the 258:290
       proportion the windows were drawn at. */
    --cw: calc((100cqw - (var(--n) - 1) * var(--g)) / var(--n));
    --rh: calc(var(--cw) * var(--ratio));
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    grid-auto-rows: var(--rh);
    gap: var(--g);
  }
  .fb-tile {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    isolation: isolate;
    --bg: var(--up-emerald);
    --line: var(--up-line-on-dark);
    --ink: var(--up-on-dark);
    --ink-soft: var(--up-on-dark-soft);
    background: var(--bg);
  }
  .fb-tile--mint { --bg: var(--up-mint); --line: var(--up-line-emerald); --ink: var(--up-emerald-ink); --ink-soft: var(--up-emerald-ink); }
  /* The shared field: sized to the whole grid and offset by this tile's place
     in it, so neighbouring tiles continue each other's lines. */
  .fb-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--line);
    -webkit-mask: var(--field) no-repeat;
    mask: var(--field) no-repeat;
    -webkit-mask-size: 100cqw calc(var(--m) * var(--rh) + (var(--m) - 1) * var(--g));
    mask-size: 100cqw calc(var(--m) * var(--rh) + (var(--m) - 1) * var(--g));
    -webkit-mask-position: calc(var(--c) * (var(--cw) + var(--g)) * -1) calc(var(--r) * (var(--rh) + var(--g)) * -1);
    mask-position: calc(var(--c) * (var(--cw) + var(--g)) * -1) calc(var(--r) * (var(--rh) + var(--g)) * -1);
  }
  .fb-copy {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--copy);
    box-sizing: border-box;
    padding: clamp(var(--space-4), 2.2cqw, var(--space-6)) clamp(var(--space-4), 1.9cqw, var(--space-5));
  }
  .fb-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    /* Sized from the column, so a 1-column tile's title stays on one line. */
    font-size: clamp(16px, calc(var(--cw) * 0.082), 21px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .fb-sub {
    margin: var(--space-1) 0 0;
    font-size: clamp(12px, calc(var(--cw) * 0.056), 13.5px);
    line-height: 1.4;
    color: var(--ink-soft);
    opacity: 0.9;
  }
  /* Type tile: a label, one big line, chips at the foot. */
  .fb-type {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(var(--space-4), 2.2cqw, var(--space-6)) clamp(var(--space-4), 1.9cqw, var(--space-5));
  }
  .fb-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .fb-big {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, calc(var(--cw) * 0.24), 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .fb-chips {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .fb-chips li {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .fb-win {
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--win);
    height: auto;
    display: block;
  }
  @media (max-width: 1119px) {
    .fb-grid { grid-template-columns: 1fr; grid-auto-rows: auto; max-width: 560px; margin-inline: auto; }
    .fb-tile { grid-column: auto !important; grid-row: auto !important; }
    .fb-tile::before {
      -webkit-mask-size: 260% auto;
      mask-size: 260% auto;
      -webkit-mask-position: calc(var(--i) * 24%) calc(var(--i) * 22%);
      mask-position: calc(var(--i) * 24%) calc(var(--i) * 22%);
    }
    .fb-copy { position: static; width: auto; padding: var(--space-5) var(--space-5) var(--space-3); }
    .fb-type { position: static; padding: var(--space-5); gap: var(--space-4); }
    .fb-chips { margin-top: 0; }
    .fb-title { font-size: 20px; }
    .fb-sub { font-size: 13px; }
    .fb-win {
      position: static;
      margin-left: var(--space-2);
      width: var(--mw);
      max-width: none;
      max-height: var(--mh);
      object-fit: cover;
      object-position: left top;
    }
  }
</style>
