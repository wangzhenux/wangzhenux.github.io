---
interface Props { metric: string; heading?: string; }
const { metric, heading } = Astro.props;
---
<div class="outcome">
  <div class="outcome-num">{metric}</div>
  <div class="outcome-text">
    {heading && <h3>{heading}</h3>}
    <div class="outcome-body"><slot /></div>
  </div>
  <slot name="image" />
</div>
<style>
  /* ported from case-study-twilio.html .outcome, tokenized.
     Big metric + supporting text on top; an optional full-width image (via the
     `image` slot) spans both columns below for visual weight. */
  .outcome {
    margin: var(--space-12) 0 var(--space-11);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-9) var(--space-10);
    align-items: center;
  }
  .outcome-num {
    font-family: var(--font-display);
    /* ~140px metric, clamped down for mobile (§9.3) */
    font-size: var(--fs-display);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--accent);
    font-weight: 500;
  }
  .outcome-text h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    margin: 0 0 var(--space-3);
    font-weight: 500;
    line-height: var(--lh-title);
  }
  /* div, not p: MDX wraps the slot in its own <p>, which can't nest in a <p>. */
  .outcome-text .outcome-body {
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink-secondary);
    margin: 0;
  }
  .outcome-body :global(p) { margin: 0; }
  /* full-width image spans both columns when a page slots one in */
  .outcome :global([slot="image"]),
  .outcome :global(.outcome-image) {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
  }
  /* Metric above the text on mobile. */
  @media (max-width: 767px) {
    .outcome { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); }
  }
</style>
