---
/**
 * A design system at a glance: specimens grouped like a system site
 * (Foundations, Actions, Inputs, …) on a full-bleed band, with a Light / Dark
 * switch that swaps every specimen for its dark render and turns the band dark.
 * Each specimen ships as a light and a dark image of the same size; only the
 * visible one loads (the other is display:none + lazy). Without JS it rests on
 * light, so the page is complete at rest. Token-only CSS.
 *
 *   <DSShowcase label="…" groups={[{ label: 'Actions', items: [
 *     { label, alt, light, dark, width, height, wide? }, …] }, …]} />
 */
interface Specimen {
  label: string;
  alt: string;
  light: string;
  dark: string;
  width: number;
  height: number;
  /** Spans two columns (for wide specimens such as a KPI row or a table). */
  wide?: boolean;
}
interface Group { label: string; items: Specimen[] }
interface Props { label: string; groups: Group[] }
const { label, groups } = Astro.props;
---
<section class="dss" data-mode="light" aria-label={label}>
  <div class="dss-inner">
    <div class="dss-bar">
      <p class="dss-title">{label}</p>
      <div class="dss-switch" role="group" aria-label="Show the specimens in">
        <button type="button" class="dss-btn" data-set="light" aria-pressed="true">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Light
        </button>
        <button type="button" class="dss-btn" data-set="dark" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          Dark
        </button>
      </div>
    </div>
    {groups.map((g) => (
      <div class="dss-group">
        <p class="dss-glabel">{g.label}</p>
        <div class="dss-grid">
          {g.items.map((it) => (
            <figure class:list={['dss-item', { 'dss-item--wide': it.wide }]}>
              <div class="dss-frame">
                <img class="dss-img dss-img--light" src={it.light} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
                <img class="dss-img dss-img--dark" src={it.dark} alt={`${it.alt}, in dark mode`} width={it.width} height={it.height} loading="lazy" decoding="async" />
              </div>
              <figcaption>{it.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .dss {
    position: relative;
    width: calc(100vw - var(--sbw));
    margin: var(--space-9) calc(50% - (100vw - var(--sbw)) / 2);
    padding-block: var(--space-9) var(--space-11);
    background-color: var(--bg-secondary);
    background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
    background-size: 28px 28px;
    transition: background-color 0.3s ease;
  }
  .dss[data-mode='dark'] { background-color: var(--bg-inverse); background-image: none; }
  .dss-inner {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--space-12);
    display: grid;
    gap: var(--space-8);
  }
  @media (max-width: 767px) {
    .dss-inner { padding-inline: var(--pad-page-x); }
  }
  .dss-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .dss-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.25;
    color: var(--ink-primary);
  }
  .dss[data-mode='dark'] .dss-title { color: var(--ink-on-dark); }
  .dss-switch {
    display: inline-flex;
    padding: var(--space-1);
    gap: var(--space-1);
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
  }
  .dss-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    font-size: var(--fs-card);
    cursor: pointer;
  }
  .dss-btn svg { width: 16px; height: 16px; }
  .dss-btn[aria-pressed='true'] { background: var(--bg-inverse); color: var(--ink-on-dark); }
  .dss-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dss-group { display: grid; gap: var(--space-4); }
  .dss-glabel {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .dss[data-mode='dark'] .dss-glabel { color: var(--accent-on-dark); }
  .dss-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: start;
  }
  .dss-item { margin: 0; display: grid; gap: var(--space-2); min-width: 0; }
  .dss-item--wide { grid-column: span 2; }
  .dss-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--bg-primary);
  }
  .dss[data-mode='dark'] .dss-frame { border-color: transparent; background: transparent; }
  .dss-img { display: block; width: 100%; height: auto; }
  .dss-img--dark { display: none; }
  .dss[data-mode='dark'] .dss-img--light { display: none; }
  .dss[data-mode='dark'] .dss-img--dark { display: block; }
  .dss-item figcaption { font-size: var(--fs-card); color: var(--ink-secondary); }
  .dss[data-mode='dark'] .dss-item figcaption { color: var(--ink-on-dark); opacity: 0.75; }
  @media (max-width: 900px) {
    .dss-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .dss-grid { grid-template-columns: minmax(0, 1fr); }
    .dss-item--wide { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dss { transition: none; }
  }
</style>
<script>
  function initDSShowcase() {
    document.querySelectorAll<HTMLElement>('.dss').forEach((root) => {
      if (root.dataset.dssReady) return;
      root.dataset.dssReady = '1';
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.dss-btn'));
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          root.dataset.mode = b.dataset.set ?? 'light';
          buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        }),
      );
    });
  }
  initDSShowcase();
  document.addEventListener('astro:after-swap', initDSShowcase);
</script>
