---
/**
 * A design system as one organized canvas, the way it lives in a design file:
 * every specimen at the same scale, grouped into named frames (Foundations,
 * Actions, …). It opens fit-to-view so the whole system reads at a glance; the
 * reader drags to pan and zooms with the buttons, pinch, or ⌘/Ctrl + scroll.
 * A Light / Dark switch swaps every specimen for its dark render and turns the
 * canvas dark. Each specimen ships as a light and a dark image of the same size
 * (3× captures); only the visible set loads (the other is display:none + lazy).
 * Without JS the board sits at 1× inside a scrollable box. Token-only CSS.
 *
 *   <DSShowcase label="…" groups={[{ label: 'Actions', items: [
 *     { label, alt, light, dark, width, height }, …] }, …]} />
 */
interface Specimen {
  label: string;
  alt: string;
  light: string;
  dark: string;
  width: number;
  height: number;
}
interface Group { label: string; items: Specimen[] }
interface Props { label: string; groups: Group[] }
const { label, groups } = Astro.props;

// Board layout, in CSS px at 1× (captures are 3×). Each group is a frame; its
// specimens fill columns top to bottom up to a shared height, and the frames sit
// side by side. The shared height is picked so the board is about as wide as the
// canvas (≈2.4:1), so fit-to-view wastes little space.
const DPR = 3, GAP = 40, CAP = 40, PAD = 48, HEAD = 128, FGAP = 120, EDGE = 64, ASPECT = 2.4;
type Placed = Specimen & { x: number; y: number; w: number; h: number };
function pack(H: number) {
  let fx = EDGE;
  const frames: { label: string; x: number; y: number; w: number; h: number }[] = [];
  const placed: Placed[] = [];
  let maxH = 0;
  for (const g of groups) {
    const top = EDGE + HEAD;
    let cx = fx + PAD, cy = top, colW = 0, frameH = 0;
    for (const it of g.items) {
      const w = Math.round(it.width / DPR), h = Math.round(it.height / DPR);
      if (cy > top && cy - top + h + CAP > H) { cx += colW + GAP; cy = top; colW = 0; }
      placed.push({ ...it, x: cx, y: cy, w, h });
      colW = Math.max(colW, w);
      cy += h + CAP + GAP;
      frameH = Math.max(frameH, cy - GAP - top);
    }
    const fw = cx + colW + PAD - fx;
    frames.push({ label: g.label, x: fx, y: EDGE, w: fw, h: HEAD + frameH + PAD });
    maxH = Math.max(maxH, HEAD + frameH + PAD);
    fx += fw + FGAP;
  }
  return { frames, placed, W: fx - FGAP + EDGE, H: maxH + EDGE * 2 };
}
const tallest = Math.max(...groups.flatMap((g) => g.items.map((it) => it.height / DPR + CAP)));
let best = pack(tallest);
for (let H = tallest; H < 6000; H += 20) {
  const b = pack(H);
  if (Math.abs(b.W / b.H - ASPECT) < Math.abs(best.W / best.H - ASPECT)) best = b;
}
const { frames, placed, W, H } = best;
---
<section class="dss" data-mode="light" aria-label={label}>
  <p class="dss-title">{label}</p>
  <div class="dss-canvas" tabindex="0" role="region" aria-label={`${label}: a canvas of ${placed.length} specimens. Drag or use the arrow keys to move, plus and minus to zoom, 0 to fit.`}>
    <div class="dss-board" style={`width:${W}px;height:${H}px`}>
      {frames.map((f) => (
        <div class="dss-fr" style={`left:${f.x}px;top:${f.y}px;width:${f.w}px;height:${f.h}px`}>
          <p class="dss-fl" style={`left:${PAD}px;top:${PAD - 8}px`}>{f.label}</p>
        </div>
      ))}
      {placed.map((it) => (
        <figure class="dss-item" style={`left:${it.x}px;top:${it.y}px;width:${it.w}px`}>
          <div class="dss-frame" style={`aspect-ratio:${it.width} / ${it.height}`}>
            <img class="dss-img dss-img--light" src={it.light} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" draggable="false" />
            <img class="dss-img dss-img--dark" src={it.dark} alt={`${it.alt.replace(/\.$/, '')}, in dark mode`} width={it.width} height={it.height} loading="lazy" decoding="async" draggable="false" />
          </div>
          <figcaption>{it.label}</figcaption>
        </figure>
      ))}
    </div>
    <div class="dss-bar">
      <p class="dss-hint" hidden>Drag to move · pinch or ⌘/Ctrl + scroll to zoom</p>
      <div class="dss-tools">
        <div class="dss-switch" role="group" aria-label="Show the specimens in">
          <button type="button" class="dss-btn" data-set="light" aria-pressed="true">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Light
          </button>
          <button type="button" class="dss-btn" data-set="dark" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            Dark
          </button>
        </div>
        <div class="dss-zoom" hidden>
          <button type="button" class="dss-zb" data-zoom="out" aria-label="Zoom out">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <output class="dss-pct" aria-live="polite">100%</output>
          <button type="button" class="dss-zb" data-zoom="in" aria-label="Zoom in">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="dss-zb dss-zb--fit" data-zoom="fit" aria-label="Fit the whole canvas">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Fit
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .dss {
    --dss-inset: max(var(--pad-page-x), calc((100vw - var(--sbw)) / 2 - var(--max-content) / 2 + var(--pad-page-x)));
    --z: 1;
    width: calc(100vw - var(--sbw));
    margin: var(--space-9) calc(50% - (100vw - var(--sbw)) / 2);
    display: grid;
    gap: var(--space-4);
  }
  .dss-title {
    margin: 0;
    padding-inline: var(--dss-inset);
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.25;
    color: var(--ink-primary);
  }
  .dss-canvas {
    position: relative;
    height: clamp(440px, 64vh, 620px);
    overflow: auto;
    background-color: var(--bg-secondary);
    background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
    background-size: 24px 24px;
    transition: background-color 0.3s ease;
    outline: none;
  }
  .dss-canvas:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  .dss[data-mode='dark'] .dss-canvas {
    background-color: var(--bg-inverse);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--ink-on-dark) 14%, transparent) 1px, transparent 1.5px);
  }
  /* Live: the board is transformed instead of scrolled. */
  .dss-canvas.is-live { overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; }
  .dss-canvas.is-live.is-dragging { cursor: grabbing; }
  .dss-board { position: relative; transform-origin: 0 0; }
  .dss-fr {
    position: absolute;
    border-radius: 24px;
    background: color-mix(in srgb, var(--bg-primary) 70%, transparent);
    border: 1px solid var(--rule);
  }
  .dss[data-mode='dark'] .dss-fr {
    background: color-mix(in srgb, var(--ink-on-dark) 4%, transparent);
    border-color: color-mix(in srgb, var(--ink-on-dark) 10%, transparent);
  }
  /* Frame names sit in the frame's header band and stay the same size on
     screen at any zoom, as in a design file. */
  .dss-fl {
    position: absolute;
    margin: 0;
    transform-origin: 0 0;
    transform: scale(calc(1 / var(--z)));
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-secondary);
  }
  .dss[data-mode='dark'] .dss-fl { color: var(--accent-on-dark); }
  .dss-item { position: absolute; margin: 0; }
  .dss-frame {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--rule);
    background: var(--bg-primary);
  }
  .dss[data-mode='dark'] .dss-frame { border-color: transparent; background: transparent; }
  .dss-img { display: block; width: 100%; height: auto; pointer-events: none; }
  .dss-img--dark { display: none; }
  .dss[data-mode='dark'] .dss-img--light { display: none; }
  .dss[data-mode='dark'] .dss-img--dark { display: block; }
  .dss-item figcaption {
    padding-top: var(--space-3);
    font-size: 18px;
    line-height: 1.2;
    color: var(--ink-secondary);
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .dss[data-mode='dark'] .dss-item figcaption { color: var(--ink-on-dark); opacity: 0.75; }
  /* Too small to read when zoomed far out; the frame names carry the overview. */
  .dss-canvas.is-far .dss-item figcaption { opacity: 0; }

  .dss-switch,
  .dss-zoom {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1);
    gap: var(--space-1);
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-card);
  }
  .dss-bar {
    position: absolute;
    z-index: 1;
    left: var(--dss-inset);
    right: var(--dss-inset);
    bottom: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    pointer-events: none;
  }
  .dss-tools { display: flex; gap: var(--space-2); margin-left: auto; pointer-events: auto; }
  .dss-zoom[hidden] { display: none; }
  .dss-btn,
  .dss-zb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 36px;
    height: 36px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    font-size: var(--fs-card);
    cursor: pointer;
  }
  .dss-zb { padding: 0; }
  .dss-zb--fit { padding: 0 var(--space-3); }
  .dss-btn:hover, .dss-zb:hover { color: var(--ink-primary); }
  .dss-btn svg, .dss-zb svg { width: 16px; height: 16px; }
  .dss-btn[aria-pressed='true'] { background: var(--bg-inverse); color: var(--ink-on-dark); }
  .dss-btn:focus-visible, .dss-zb:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dss-pct {
    min-width: 4.5ch;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-secondary);
    font-variant-numeric: tabular-nums;
  }
  .dss-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-secondary);
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    pointer-events: none;
  }
  .dss-hint[hidden] { display: none; }
  @media (max-width: 767px) {
    .dss-title { font-size: 20px; }
    .dss-canvas { height: 420px; }
    .dss-bar { left: var(--space-3); right: var(--space-3); bottom: var(--space-3); }
    .dss-tools { margin-left: 0; width: 100%; justify-content: space-between; }
    .dss-btn { padding: 0 var(--space-2); }
    .dss-hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .dss-canvas { transition: none; } }
</style>
<script>
  function initDSShowcase() {
    document.querySelectorAll<HTMLElement>('.dss').forEach((root) => {
      if (root.dataset.dssReady) return;
      root.dataset.dssReady = '1';

      // Light / Dark
      const modes = Array.from(root.querySelectorAll<HTMLButtonElement>('.dss-btn'));
      modes.forEach((b) => b.addEventListener('click', () => {
        root.dataset.mode = b.dataset.set ?? 'light';
        modes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }));

      // Canvas: pan + zoom by transforming the board.
      const canvas = root.querySelector<HTMLElement>('.dss-canvas');
      const board = root.querySelector<HTMLElement>('.dss-board');
      const pct = root.querySelector<HTMLOutputElement>('.dss-pct');
      if (!canvas || !board) return;
      canvas.classList.add('is-live');
      root.querySelector<HTMLElement>('.dss-zoom')!.hidden = false;
      root.querySelector<HTMLElement>('.dss-hint')!.hidden = false;
      const BW = board.offsetWidth, BH = board.offsetHeight;
      let z = 1, x = 0, y = 0;
      const MAX = 2.5;

      const clamp = () => {
        const cw = canvas.clientWidth, ch = canvas.clientHeight;
        const w = BW * z, h = BH * z;
        x = w <= cw ? (cw - w) / 2 : Math.min(cw * 0.25, Math.max(cw * 0.75 - w, x));
        y = h <= ch ? (ch - h) / 2 : Math.min(ch * 0.25, Math.max(ch * 0.75 - h, y));
      };
      const apply = () => {
        clamp();
        board.style.transform = `translate(${x}px, ${y}px) scale(${z})`;
        root.style.setProperty('--z', String(z));
        canvas.classList.toggle('is-far', z < 0.42);
        if (pct) pct.value = `${Math.round(z * 100)}%`;
      };
      let minZ = 0.1;
      const fit = () => {
        const cw = canvas.clientWidth, ch = canvas.clientHeight;
        const all = Math.min(cw / BW, ch / BH);
        // On a narrow screen the whole board would be a sliver: fill the height
        // and let the reader pan sideways instead.
        const narrow = all < 0.16 && ch / BH > all;
        z = narrow ? ch / BH : all;
        minZ = all * 0.9;
        x = narrow ? 0 : (cw - BW * z) / 2;
        y = (ch - BH * z) / 2;
        apply();
      };
      const zoomAt = (factor: number, cx: number, cy: number) => {
        const nz = Math.min(MAX, Math.max(minZ, z * factor));
        x = cx - (cx - x) * (nz / z);
        y = cy - (cy - y) * (nz / z);
        z = nz;
        apply();
      };
      const centre = () => [canvas.clientWidth / 2, canvas.clientHeight / 2] as const;

      root.querySelectorAll<HTMLButtonElement>('.dss-zb').forEach((b) => b.addEventListener('click', () => {
        if (b.dataset.zoom === 'fit') fit();
        else zoomAt(b.dataset.zoom === 'in' ? 1.4 : 1 / 1.4, ...centre());
      }));

      // Pointer: one pointer pans, two pinch.
      const pts = new Map<number, { x: number; y: number }>();
      let last: { x: number; y: number } | null = null, pinch0 = 0;
      const local = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
      canvas.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        canvas.setPointerCapture(e.pointerId);
        pts.set(e.pointerId, local(e));
        if (pts.size === 1) { last = local(e); canvas.classList.add('is-dragging'); }
        if (pts.size === 2) { const [a, b] = [...pts.values()]; pinch0 = Math.hypot(a.x - b.x, a.y - b.y); }
      });
      canvas.addEventListener('pointermove', (e) => {
        if (!pts.has(e.pointerId)) return;
        const p = local(e);
        pts.set(e.pointerId, p);
        if (pts.size === 2) {
          const [a, b] = [...pts.values()];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (pinch0) zoomAt(d / pinch0, (a.x + b.x) / 2, (a.y + b.y) / 2);
          pinch0 = d;
          return;
        }
        if (last) { x += p.x - last.x; y += p.y - last.y; last = p; apply(); }
      });
      const up = (e: PointerEvent) => {
        pts.delete(e.pointerId);
        if (pts.size < 2) pinch0 = 0;
        if (pts.size === 1) last = [...pts.values()][0];
        if (!pts.size) { last = null; canvas.classList.remove('is-dragging'); }
      };
      canvas.addEventListener('pointerup', up);
      canvas.addEventListener('pointercancel', up);
      canvas.addEventListener('dblclick', (e) => { const p = local(e as unknown as PointerEvent); zoomAt(2, p.x, p.y); });

      // Wheel: ⌘/Ctrl + scroll (and trackpad pinch) zooms, sideways scroll pans;
      // plain vertical scroll is left to the page.
      canvas.addEventListener('wheel', (e) => {
        const r = canvas.getBoundingClientRect();
        if (e.ctrlKey || e.metaKey) {
          e.preventDefault();
          zoomAt(Math.exp(-e.deltaY * 0.01), e.clientX - r.left, e.clientY - r.top);
        } else if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey) {
          e.preventDefault();
          x -= e.shiftKey ? e.deltaY : e.deltaX;
          apply();
        }
      }, { passive: false });

      canvas.addEventListener('keydown', (e) => {
        const step = 80;
        const k = e.key;
        if (k === 'ArrowLeft') x += step;
        else if (k === 'ArrowRight') x -= step;
        else if (k === 'ArrowUp') y += step;
        else if (k === 'ArrowDown') y -= step;
        else if (k === '+' || k === '=') { zoomAt(1.4, ...centre()); e.preventDefault(); return; }
        else if (k === '-') { zoomAt(1 / 1.4, ...centre()); e.preventDefault(); return; }
        else if (k === '0') { fit(); e.preventDefault(); return; }
        else return;
        e.preventDefault();
        apply();
      });

      let rw = canvas.clientWidth;
      new ResizeObserver(() => { if (canvas.clientWidth !== rw) { rw = canvas.clientWidth; fit(); } }).observe(canvas);
      fit();
    });
  }
  initDSShowcase();
  document.addEventListener('astro:after-swap', initDSShowcase);
</script>
