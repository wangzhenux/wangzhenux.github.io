---
/**
 * The Portal's capabilities at a glance: real product screens in consistent
 * frames, cropped by flat emerald and mint tiles, plus a few abstract objects
 * floating on top (the question you'd ask, the tour that got booked, the
 * checks a post passes before it goes out). Every frame runs past its tile's
 * bottom edge, so only its top corners show.
 *
 * Motion (in-view island, per tile): the tile rises in, its screen slides up
 * into place, then the floating objects land. Everything is in its final state
 * without JS or with reduced motion. Layout follows the container: 6 columns,
 * then 2, then 1. Token-only CSS.
 */
const base = '/cases/unitpulse-platform';
const check = [
  { ok: true, text: 'Fair Housing language' },
  { ok: true, text: 'Price backed by property data' },
  { ok: false, text: "Address doesn't match" },
];
---
<section class="pb" aria-label="What the platform does, at a glance">
  <ul class="pb-grid">
    <li class="pb-t pb-ins" style="--i: 0" data-inview>
      <p class="pb-eb">Insight</p>
      <h3>Every morning, the biggest leak called out</h3>
      <div class="pb-stage">
        <div class="pb-fr" style="--w: 820px">
          <img src={`${base}/ds/foryou-after.jpg`} alt="The Insight For You page, with the daily brief on top" width="2940" height="1846" loading="lazy" decoding="async" />
        </div>
        <span class="pb-float pb-pill" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"/></svg>
          Why did applications drop?
        </span>
      </div>
    </li>

    <li class="pb-t pb-t--dark pb-app" style="--i: 1" data-inview>
      <p class="pb-eb">Agents' app</p>
      <h3>Tours, summarized</h3>
      <div class="pb-stage">
        <div class="pb-ph">
          <img src={`${base}/mobile/phone-details.jpg`} alt="The agents' app showing a tour summary and a suggested follow-up" width="1206" height="2622" loading="lazy" decoding="async" />
        </div>
      </div>
    </li>

    <li class="pb-t pb-lea" style="--i: 0" data-inview>
      <p class="pb-eb">Leasing</p>
      <h3>The AI books the tour</h3>
      <div class="pb-stage">
        <div class="pb-fr" style="--w: 400px">
          <img src={`${base}/bento/chat.png`} alt="A text conversation where the AI offers tour times and the renter picks 2 PM" width="1200" height="990" loading="lazy" decoding="async" />
        </div>
        <div class="pb-float pb-evt" aria-hidden="true">
          <span class="pb-evt-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M9 16l2 2 4-4"/></svg>
          </span>
          <span><b>Tour · Unit 204</b><span>Sat, Oct 3 · 2:00 PM</span></span>
        </div>
      </div>
    </li>

    <li class="pb-t pb-pipe" style="--i: 1" data-inview>
      <p class="pb-eb">Pipeline</p>
      <h3>Every lead in one pipeline</h3>
      <div class="pb-stage">
        <div class="pb-fr" style="--w: 560px">
          <img src={`${base}/bento/kanban.png`} alt="The Customers pipeline with leads in Inquiry and Tour columns" width="2160" height="1260" loading="lazy" decoding="async" />
        </div>
      </div>
    </li>

    <li class="pb-t pb-fun" style="--i: 2" data-inview>
      <p class="pb-eb">Funnel</p>
      <h3>See where renters leave</h3>
      <div class="pb-stage">
        <div class="pb-fr" style="--w: 430px">
          <img src={`${base}/bento/funnel.png`} alt="The customer journey flow, showing where renters drop off" width="1920" height="1140" loading="lazy" decoding="async" />
        </div>
      </div>
    </li>

    <li class="pb-t pb-mkt" style="--i: 0" data-inview>
      <div class="pb-left">
        <p class="pb-eb">Marketing</p>
        <h3>Posts drafted from market data, held when a fact is off</h3>
        <div class="pb-float pb-check">
          <p>Before it posts</p>
          <ul>
            {check.map((c, k) => (
              <li class:list={[c.ok ? 'is-ok' : 'is-flag']} style={`--k: ${k}`}>
                {c.ok ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                )}
                {c.text}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="pb-stage">
        <div class="pb-fr" style="--w: 820px">
          <img src={`${base}/marketing/draft.jpg`} alt="The Create post screen, with a draft held for review" width="2400" height="1500" loading="lazy" decoding="async" />
        </div>
      </div>
    </li>
  </ul>
</section>
<style>
  .pb { container-type: inline-size; margin: var(--space-9) 0; }
  .pb-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .pb-t {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-6) 0;
    border-radius: 24px;
    background: var(--up-mint);
  }
  .pb-t--dark { background: var(--up-emerald); }
  .pb-ins { grid-column: span 4; height: 430px; }
  .pb-app { grid-column: span 2; height: 430px; }
  .pb-lea, .pb-pipe, .pb-fun { grid-column: span 2; height: 350px; }
  .pb-mkt { grid-column: span 6; height: 330px; flex-direction: row; gap: var(--space-7); padding: var(--space-6); }

  .pb-eb {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--up-sub);
  }
  .pb-t--dark .pb-eb { color: var(--up-on-dark-soft); }
  .pb-t h3 {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.22;
    color: var(--up-emerald-ink);
    white-space: nowrap;
  }
  .pb-t--dark h3 { color: var(--up-on-dark); }

  /* Every screen sits the same distance below its title. */
  .pb-stage { position: relative; flex: 1; margin-top: var(--space-6); }
  /* Frames run past the tile's bottom edge, so only the top corners show. */
  .pb-fr {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w);
    height: calc(100% + var(--space-8));
    overflow: hidden;
    border-radius: 14px;
    background: var(--up-paper);
    box-shadow: var(--up-frame-shadow);
  }
  .pb-fr img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .pb-ph {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 196px;
    margin-inline: auto;
    overflow: hidden;
    border: 7px solid var(--up-bezel);
    border-radius: 32px;
    box-shadow: var(--up-frame-shadow);
  }
  .pb-ph img { display: block; width: 100%; height: auto; }

  /* Floating objects */
  .pb-float { z-index: 2; background: var(--up-paper); box-shadow: var(--up-float-shadow); }
  .pb-pill {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-6);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--up-ink);
  }
  .pb-pill svg { width: 14px; height: 14px; color: var(--up-ai); }
  .pb-evt {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-6);
    width: 240px;
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border-radius: 14px;
  }
  .pb-evt-ic { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--up-mint); color: var(--up-emerald); }
  .pb-evt-ic svg { width: 18px; height: 18px; }
  .pb-evt b { display: block; font-size: 13px; color: var(--up-ink); }
  .pb-evt span span { display: block; font-size: 12px; color: var(--up-muted); }

  /* Marketing: the title and the checks on the left, the screen on the right. */
  .pb-left { flex: 0 0 250px; display: flex; flex-direction: column; }
  .pb-mkt h3 { white-space: normal; }
  .pb-mkt .pb-stage { margin-top: 0; }
  .pb-check { margin-top: auto; padding: var(--space-3) var(--space-4); border-radius: 16px; }
  .pb-check p {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--up-muted);
  }
  .pb-check ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .pb-check li { display: flex; align-items: center; gap: var(--space-3); font-size: 13px; color: var(--up-ink); }
  .pb-check svg { flex: none; width: 18px; height: 18px; }
  .pb-check .is-ok svg { color: var(--up-emerald); }
  .pb-check .is-flag { font-weight: 600; color: var(--up-amber-ink); }
  .pb-check .is-flag svg { color: var(--up-amber); }

  /* 2 columns: Insight across the top, then pairs. */
  @container (max-width: 860px) {
    .pb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pb-ins { grid-column: span 2; height: 400px; }
    .pb-app, .pb-lea { grid-column: span 1; height: 420px; }
    .pb-pipe, .pb-fun { grid-column: span 1; height: 340px; }
    .pb-mkt { grid-column: span 2; }
    .pb-t h3 { white-space: normal; text-wrap: balance; }
    .pb-left { flex-basis: 220px; }
  }
  /* 1 column: Marketing stacks its title, checks and screen. */
  @container (max-width: 560px) {
    .pb-grid { grid-template-columns: minmax(0, 1fr); }
    .pb-ins, .pb-app, .pb-lea, .pb-pipe, .pb-fun, .pb-mkt { grid-column: span 1; }
    .pb-ins { height: 380px; }
    .pb-app { height: 440px; }
    .pb-lea { height: 380px; }
    .pb-pipe, .pb-fun { height: 330px; }
    .pb-t { padding: var(--space-5) var(--space-5) 0; }
    .pb-mkt { height: auto; flex-direction: column; gap: 0; padding-bottom: 0; }
    .pb-left { flex: none; }
    .pb-check { margin-top: var(--space-5); }
    .pb-mkt .pb-stage { flex: none; height: 260px; margin-top: var(--space-6); }
  }

  /* Motion: the tile rises in, its screen slides up into place, then the floats land. */
  .pb-t { transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--i) * 0.08s); }
  .pb-fr, .pb-ph { transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.2, 0.75, 0.15, 1); transition-delay: calc(var(--i) * 0.08s + 0.15s); }
  .pb-pill, .pb-evt { transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1.15); transition-delay: calc(var(--i) * 0.08s + 0.7s); }
  .pb-check { transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); transition-delay: 0.35s; }
  .pb-check li { transition: opacity 0.35s ease, transform 0.35s ease; transition-delay: calc(0.6s + var(--k) * 0.14s); }
  :global(html.inview-armed) .pb-t:not(.is-in) { opacity: 0; transform: translateY(var(--space-5)); }
  :global(html.inview-armed) .pb-t:not(.is-in) :is(.pb-fr, .pb-ph) { opacity: 0; transform: translateY(var(--space-9)); }
  :global(html.inview-armed) .pb-t:not(.is-in) :is(.pb-pill, .pb-evt, .pb-check) { opacity: 0; transform: translateY(var(--space-3)) scale(0.96); }
  :global(html.inview-armed) .pb-t:not(.is-in) .pb-check li { opacity: 0; transform: translateX(calc(-1 * var(--space-2))); }
  @media (prefers-reduced-motion: reduce) {
    .pb-t, .pb-fr, .pb-ph, .pb-pill, .pb-evt, .pb-check, .pb-check li { transition: none; }
  }
</style>
