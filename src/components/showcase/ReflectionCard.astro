---
/**
 * One reflection: mono label, display heading, body. Optional `art` adds a
 * small abstract illustration above the label that carries the statement:
 *   - 'spec'     a spec page feeding a tidy grid of matching blocks, with the
 *                drift it replaced fading behind (write it down, then build)
 *   - 'handoff'  a conversation line through an AI station; at the hand-off
 *                point a person takes the thread and the AI's line goes quiet
 */
interface Props { label: string; heading: string; art?: 'spec' | 'handoff'; }
const { label, heading, art } = Astro.props;
---
<div class="reflection-card">
  {art && (
    <div class="rc-art" aria-hidden="true">
      {art === 'spec' && (
        <svg viewBox="0 0 320 140" fill="none">
          {/* the drift it replaced */}
          <rect class="rc-ghost" x="170" y="22" width="34" height="30" rx="6" transform="rotate(-9 187 37)" />
          <rect class="rc-ghost" x="250" y="88" width="38" height="28" rx="9" transform="rotate(7 269 102)" />
          <rect class="rc-ghost" x="218" y="16" width="30" height="34" rx="3" transform="rotate(5 233 33)" />
          {/* the spec */}
          <rect class="rc-page" x="22" y="18" width="84" height="104" rx="8" />
          <path class="rc-acc" d="M34 34h28" stroke-width="3" stroke-linecap="round" />
          <path class="rc-ink" d="M34 48h56M34 58h48M34 68h54M34 78h38" stroke-width="2" stroke-linecap="round" />
          <circle class="rc-dot-a" cx="40" cy="100" r="6" />
          <circle class="rc-dot-b" cx="56" cy="100" r="6" />
          <circle class="rc-dot-c" cx="72" cy="100" r="6" />
          {/* then build */}
          <path class="rc-acc" d="M118 70h30m-8-7l8 7-8 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <g class="rc-blocks">
            <rect x="164" y="34" width="40" height="32" rx="7" />
            <rect x="212" y="34" width="40" height="32" rx="7" />
            <rect x="260" y="34" width="40" height="32" rx="7" />
            <rect x="164" y="74" width="40" height="32" rx="7" />
            <rect x="212" y="74" width="40" height="32" rx="7" />
            <rect x="260" y="74" width="40" height="32" rx="7" />
          </g>
          <path class="rc-acc" d="M172 50h18M220 50h22M268 50h14M172 90h22M220 90h14M268 90h20" stroke-width="2" stroke-linecap="round" />
        </svg>
      )}
      {art === 'handoff' && (
        <svg viewBox="0 0 320 140" fill="none">
          {/* the conversation, through an AI station */}
          <path class="rc-ink" d="M24 50h126" stroke-width="2" />
          <circle class="rc-node-edge" cx="68" cy="50" r="11" />
          <path class="rc-acc" d="M68 44v12M62 50h12" stroke-width="2" stroke-linecap="round" />
          <circle class="rc-node" cx="150" cy="50" r="7" />
          {/* the AI goes quiet once a person replies */}
          <path class="rc-mute" d="M158 50h104" stroke-width="2" stroke-dasharray="4 5" />
          <circle class="rc-mute" cx="272" cy="50" r="8" stroke-width="2" />
          {/* the person takes the thread */}
          <path class="rc-acc" d="M150 58c4 28 24 44 56 44" stroke-width="2.5" stroke-linecap="round" />
          <rect class="rc-safe" x="204" y="86" width="96" height="34" rx="17" />
          <circle class="rc-acc" cx="226" cy="99" r="5" stroke-width="2" />
          <path class="rc-acc" d="M216 114c2-5 6-8 10-8s8 3 10 8" stroke-width="2" stroke-linecap="round" />
          <path class="rc-acc" d="M248 103h38" stroke-width="2" stroke-linecap="round" />
        </svg>
      )}
    </div>
  )}
  <div class="label">{label}</div>
  <h3>{heading}</h3>
  <div class="rc-body"><slot /></div>
</div>
<style>
  /* ported from case-study-twilio.html .reflection-card, tokenized.
     Mono accent label + display-serif h4 + body paragraph. */
  .reflection-card .label {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: var(--space-2);
  }
  .reflection-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h6);
    margin: 0 0 var(--space-2);
    font-weight: 500;
  }
  /* div, not p: MDX wraps the slot in its own <p>, which can't nest in a <p>. */
  .reflection-card .rc-body {
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink-secondary);
    margin: 0;
  }
  .rc-body :global(p) { margin: 0; }

  /* --- optional illustration --- */
  .rc-art {
    margin-bottom: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .rc-art svg { display: block; width: 100%; height: auto; }
  .rc-ink { stroke: var(--ink-primary); }
  .rc-acc { stroke: var(--accent); }
  .rc-mute { stroke: var(--ink-quaternary); }
  .rc-ghost { stroke: var(--ink-quaternary); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .rc-page { fill: var(--bg-primary); stroke: var(--rule); stroke-width: 1.5; }
  .rc-dot-a { fill: var(--accent); }
  .rc-dot-b { fill: var(--accent-medium); }
  .rc-dot-c { fill: var(--ink-primary); }
  .rc-blocks rect { fill: var(--bg-primary); stroke: var(--accent-medium); stroke-width: 1.5; }
  .rc-node { fill: var(--ink-primary); }
  .rc-node-edge { fill: var(--bg-primary); stroke: var(--accent); stroke-width: 2.5; }
  .rc-safe { fill: var(--accent-soft); stroke: var(--accent-medium); stroke-width: 1.5; }
</style>
