---
/**
 * "What broke, and what we changed" — a horizontal row of fix stories. Each card
 * carries a principle eyebrow, a title in the user's own words, one line for what
 * happened and one for what changed, then the before → after visual. The cards
 * share row lines (CSS subgrid), so every card's lines and visuals start at the
 * same height whatever the length of its text. The "before" is a
 * small ChatMock reconstructed from the fix (labelled as such); the "after" is a
 * real capture when one exists, else a ChatMock.
 *
 * Mechanics mirror ShowcasePhones: a scroll-snap track on a full-bleed band,
 * prev/next buttons that step a card at a time, the track focusable so arrow
 * keys scroll it. On phones one card shows with the next peeking in.
 *
 * A single story fills the content width instead: words on the left, the
 * before → after on the right (stacked, words first, below 900px).
 *
 * Motion: cards rise in as the band enters (in-view island); the before → after
 * arrow nudges once. Static without JS / with reduced motion. Token-only CSS.
 */
import ChatMock, { type ChatMsg } from './ChatMock.astro';

interface Card {
  principle: string;
  /** In the user's words, e.g. "Widen my budget by $200". */
  title: string;
  before: ChatMsg[];
  after: { src: string; alt: string; width: number; height: number } | ChatMsg[];
  happened: string;
  changed: string;
  /** Optional status chip, e.g. "Open question", "In progress". */
  status?: string;
}
interface Props {
  cards: Card[];
  label?: string;
  beforeTag?: string;
}
const { cards, label = 'What broke, and what we changed', beforeTag = 'Reconstructed from the fix' } = Astro.props;
---
<section class:list={['bk', { 'bk--single': cards.length === 1 }]} aria-roledescription="carousel" aria-label={label} data-inview>
  <div class="bk-vp">
    <ol class="bk-track" tabindex="0" aria-label={`${label}: ${cards.length} stories`}>
      {cards.map((c, i) => (
        <li class="bk-card" style={`--i: ${i}`} aria-label={`${i + 1} of ${cards.length}: ${c.title}`}>
          <p class="bk-eyebrow">
            {c.principle}
            {c.status && <span class="bk-status">{c.status}</span>}
          </p>
          <h4 class="bk-title">“{c.title}”</h4>
          <dl class="bk-lines">
            <div><dt>What happened</dt><dd>{c.happened}</dd></div>
            <div class="bk-line--changed"><dt>What we changed</dt><dd>{c.changed}</dd></div>
          </dl>
          <div class="bk-pair">
            <div class="bk-side">
              <span class="bk-side-lab">Before</span>
              <ChatMock messages={c.before} tag={beforeTag} compact label={`Before: ${c.title}`} />
            </div>
            <span class="bk-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="bk-side">
              <span class="bk-side-lab bk-side-lab--after">After</span>
              {Array.isArray(c.after) ? (
                <ChatMock messages={c.after} compact label={`After: ${c.title}`} />
              ) : (
                <figure class="bk-shot" data-zoomable>
                  <img src={c.after.src} alt={c.after.alt} width={c.after.width} height={c.after.height} loading="lazy" decoding="async" />
                </figure>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="bk-controls">
    <button class="bk-btn bk-prev" type="button" aria-label="Previous story" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <span class="bk-count" aria-live="polite"><span class="bk-cur">1</span> / {cards.length}</span>
    <button class="bk-btn bk-next" type="button" aria-label="Next story">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>
<style>
  .bk {
    position: relative;
    width: calc(100vw - var(--sbw));
    margin-inline: calc(50% - (100vw - var(--sbw)) / 2);
    margin-block: var(--space-9);
    padding-block: var(--space-9);
  }
  .bk::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--bg-secondary);
    background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
    background-size: 28px 28px;
    z-index: 0;
  }
  .bk-vp { position: relative; z-index: 1; }
  .bk-track {
    --bk-inset: max(var(--pad-page-x), calc((100vw - var(--sbw)) / 2 - var(--max-content) / 2 + var(--pad-page-x)));
    list-style: none;
    margin: 0;
    padding-block: var(--space-2);
    padding-inline: var(--bk-inset);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(620px, 86vw);
    grid-template-rows: repeat(5, auto);
    gap: var(--space-4) var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--bk-inset);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .bk-track::-webkit-scrollbar { display: none; }
  .bk-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bk-card {
    grid-row: span 5;
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: subgrid;
    padding: var(--space-6);
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  /* One story: fill the content width, words left, before → after right */
  .bk--single .bk-track { grid-auto-columns: 100%; }
  .bk--single .bk-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: 'eyebrow pair' 'title pair' 'lines pair';
    column-gap: var(--space-8);
    row-gap: var(--space-4);
    padding: var(--space-7);
  }
  .bk--single .bk-eyebrow { grid-area: eyebrow; }
  .bk--single .bk-title { grid-area: title; }
  .bk--single .bk-pair { grid-area: pair; align-self: center; }
  .bk--single .bk-lines { grid-area: lines; grid-template-rows: none; align-self: end; }
  @media (max-width: 900px) {
    .bk--single .bk-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'eyebrow' 'title' 'lines' 'pair';
      padding: var(--space-6);
    }
  }
  .bk-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .bk-status {
    padding: 0 var(--space-2);
    border: 1px dashed var(--ink-tertiary);
    border-radius: var(--radius-sm);
    color: var(--ink-tertiary);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .bk-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.25;
    font-weight: 500;
    color: var(--ink-primary);
  }
  .bk-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }
  .bk-side { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .bk-side-lab {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .bk-side-lab--after { color: var(--accent-ink); }
  .bk-arrow { width: 24px; height: 24px; color: var(--accent); align-self: center; }
  .bk-arrow svg { width: 100%; height: 100%; display: block; }
  .bk-shot { margin: 0; cursor: zoom-in; }
  .bk-shot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
  }
  /* The two lines are a subgrid too, so "what happened" and "what we changed"
     each start on a row shared by every card. */
  .bk-lines { margin: 0; grid-row: span 2; display: grid; grid-template-rows: subgrid; row-gap: var(--space-3); }
  .bk-lines > div { padding-top: var(--space-3); border-top: 1px solid var(--rule); }
  .bk-lines dt {
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .bk-lines dd { margin: 0; font-size: var(--fs-card); line-height: 1.5; color: var(--ink-secondary); }
  .bk-line--changed dt { color: var(--accent-ink); }
  .bk-line--changed dd { color: var(--ink-primary); }

  .bk-controls {
    position: relative;
    z-index: 1;
    margin-top: var(--space-6);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
  }
  .bk-count { font-family: var(--font-mono); font-size: 12px; color: var(--ink-tertiary); min-width: 4ch; text-align: center; }
  .bk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-primary);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  .bk-btn svg { width: 18px; height: 18px; }
  .bk-btn:hover { background: var(--bg-secondary); border-color: var(--ink-tertiary); }
  .bk-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bk-btn:disabled { opacity: 0.35; cursor: default; }

  /* motion */
  .bk-card { transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(min(var(--i), 3) * 0.12s); }
  :global(html.inview-armed) .bk:not(.is-in) .bk-card { opacity: 0; transform: translateY(var(--space-6)); }
  :global(html.inview-armed) .bk.is-in .bk-arrow { animation: bk-nudge 1.2s ease-in-out 0.9s 2; }
  @keyframes bk-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(var(--space-1)); }
  }

  @media (max-width: 560px) {
    .bk-card { padding: var(--space-5); }
    .bk-pair { grid-template-columns: 1fr; }
    .bk-arrow { transform: rotate(90deg); justify-self: center; }
    :global(html.inview-armed) .bk.is-in .bk-arrow { animation: none; }
  }
</style>
<script>
  function initBrokeCarousels() {
    document.querySelectorAll<HTMLElement>('.bk').forEach((root) => {
      if (root.dataset.bkReady) return;
      root.dataset.bkReady = '1';
      const track = root.querySelector<HTMLElement>('.bk-track');
      const prev = root.querySelector<HTMLButtonElement>('.bk-prev');
      const next = root.querySelector<HTMLButtonElement>('.bk-next');
      const cur = root.querySelector<HTMLElement>('.bk-cur');
      const cards = Array.from(root.querySelectorAll<HTMLElement>('.bk-card'));
      if (!track || !prev || !next || cards.length === 0) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const step = () => {
        const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
        return cards[0].getBoundingClientRect().width + gap;
      };
      const go = (dir: number) =>
        track.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
      prev.addEventListener('click', () => go(-1));
      next.addEventListener('click', () => go(1));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      });

      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 1;
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= max;
        if (cur) cur.textContent = String(Math.min(cards.length, Math.round(track.scrollLeft / step()) + 1));
        const overflows = track.scrollWidth > track.clientWidth + 1;
        root.querySelector<HTMLElement>('.bk-controls')!.style.display = overflows ? '' : 'none';
      };
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }
  initBrokeCarousels();
  document.addEventListener('astro:after-swap', initBrokeCarousels);
</script>
