---
/**
 * Research personas — a row of customer-profile cards, each with an illustrated
 * avatar, an archetype name, who they are, a few trait chips, and what experience
 * they need. Card-forward and full-bleed like <CardGrid>. The avatars are abstract
 * line illustrations (never real photos); names are research archetypes. Token-only.
 *
 *   <PersonaGrid personas={[{ avatar: "a", name: "…", who: "…", traits: ["…"], needs: "…" }]} />
 */
interface Persona {
  name: string;
  who: string;
  needs: string;
  traits?: string[];
  /** Which avatar illustration to use: 'a' | 'b' | 'c'. */
  avatar?: string;
  /** Real headshot src (public path). When set, replaces the illustrated avatar. */
  image?: string;
}
interface Props {
  personas: Persona[];
  label?: string;
}
const { personas, label = 'Renter personas' } = Astro.props;
const A =
  '" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
const avatars: Record<string, string> = {
  // decisive — short hair
  a: `<svg viewBox="0 0 40 40"><circle cx="20" cy="15.5" r="6${A}<path d="M13.5 14.5a6.5 6.5 0 0 1 13 0${A}<path d="M9 33a11 11 0 0 1 22 0${A}</svg>`,
  // open explorer — longer hair
  b: `<svg viewBox="0 0 40 40"><circle cx="20" cy="15.5" r="6${A}<path d="M12.5 18V15a7.5 7.5 0 0 1 15 0v3${A}<path d="M9 33a11 11 0 0 1 22 0${A}</svg>`,
  // shortlister — glasses
  c: `<svg viewBox="0 0 40 40"><circle cx="20" cy="15.5" r="6${A}<circle cx="17.6" cy="15.5" r="1.5${A}<circle cx="22.4" cy="15.5" r="1.5${A}<path d="M19.1 15.5h1.8${A}<path d="M9 33a11 11 0 0 1 22 0${A}</svg>`,
};
---
<section class="persona-grid" aria-label={label}>
  <ul class="pg-grid">
    {personas.map((p) => (
      <li class="pg-card">
        <div class="pg-head">
          {p.image ? (
            <img class="pg-avatar pg-avatar--photo" src={p.image} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="pg-avatar" aria-hidden="true" set:html={avatars[p.avatar ?? 'a'] ?? avatars.a} />
          )}
          <h4 class="pg-name">{p.name}</h4>
        </div>
        <p class="pg-who">{p.who}</p>
        {p.traits && p.traits.length > 0 && (
          <ul class="pg-traits">
            {p.traits.map((t) => <li class="pg-trait">{t}</li>)}
          </ul>
        )}
        <p class="pg-needs"><span class="pg-needs-label">Needs</span>{p.needs}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .persona-grid {
    position: relative;
    width: calc(100vw - var(--sbw));
    margin-inline: calc(50% - (100vw - var(--sbw)) / 2);
    margin-block: var(--space-7);
  }
  .pg-grid {
    list-style: none;
    margin: 0;
    padding-inline: var(--pad-page-x);
    max-width: var(--max-content);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .pg-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--bg-secondary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .pg-head { display: flex; align-items: center; gap: var(--space-3); }
  .pg-avatar {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 50%;
  }
  .pg-avatar :global(svg) { width: 32px; height: 32px; display: block; }
  /* Real headshot fills the circle (object-fit cover); the border-radius clips it. */
  .pg-avatar--photo { background: none; object-fit: cover; }
  .pg-name {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    margin: 0;
    font-weight: 500;
  }
  .pg-who {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-secondary);
    margin: 0;
  }
  .pg-traits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pg-trait {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-tertiary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    background: var(--bg-primary);
  }
  .pg-needs {
    margin: auto 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  .pg-needs-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: var(--space-1);
  }
  @media (max-width: 860px) {
    .pg-grid { grid-template-columns: 1fr; }
  }
</style>
