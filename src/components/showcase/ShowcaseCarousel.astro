---
import ScreenshotPlaceholder from './ScreenshotPlaceholder.astro';

/**
 * A reusable "peek" carousel for any case study (steps, design decisions, key
 * features…). Each slide is a card whose LEFT edge aligns with the case's content
 * column; the next card peeks on the right (overflow shows it) and cards sliding
 * off-left are clipped — the Apple-style feature carousel. Each card lays its
 * screenshot left / rationale right (stacking on narrow screens).
 *
 * The band is full-bleed on the same dotted grid as <ImageShowcase> for visual
 * consistency. A JS-measured `--scar-cl` aligns the first card exactly to the
 * content column (scrollbar-proof), and the card width + translate are pure CSS
 * calc off it, so it stays correct on resize.
 *
 * Behaviour: auto-advances while the slides are in the middle of the viewport and
 * waits while they're off it, so it starts when the reader scrolls to it (pass
 * `autoplay={false}` to start paused instead). It also waits while a mouse hovers
 * the slides (real movement only, so wheel-scrolling to the band still starts it),
 * while keyboard focus is on a control other than Play, and while a slide is being
 * dragged; each wait freezes the progress where it is (no reset). The reader has
 * the controls: a play / pause that sticks (and becomes REPLAY at the end; it
 * never auto-loops), prev / next, clickable dots whose active one fills as a
 * progress bar, ←/→ keys, and mouse / touch drag. A manual move or drag doesn't
 * stop it: it keeps going from the new slide. `prefers-reduced-motion` never
 * auto-advances and moves instantly; every control still works.
 *
 * Token-only CSS. The script is a bundled module, which Astro's ClientRouter runs
 * once per visit, so it also initialises on `astro:page-load` (carousels on pages
 * reached by a client-side navigation) and tears down on `astro:before-swap`.
 * Drop in a real screenshot per slide via `image`/`imageAlt`; until then `label`
 * renders a labelled placeholder.
 *
 *   <ShowcaseCarousel slides={[{ eyebrow: "01", title: "…", body: "…", label: "…" }]} />
 */
interface Slide {
  /** Small label above the title (e.g. "01", or a category). */
  eyebrow?: string;
  title: string;
  body?: string;
  /** Two labelled parts in place of `body` (e.g. What happened / What we
   *  designed); the second reads as the answer. */
  parts?: { label: string; text: string }[];
  /** Caption for the placeholder until a real screenshot is supplied. */
  label?: string;
  /** Real screenshot src (public path). When set, replaces the placeholder. */
  image?: string;
  imageAlt?: string;
  width?: number;
  height?: number;
  /** Muted demo clip (public path). Takes priority over `image`. Auto-plays from
   *  the start when its slide is active and the band is in view; never loops. */
  video?: string;
  /** Poster frame shown before play and under prefers-reduced-motion. */
  poster?: string;
  /** Optional CSS background (e.g. a brand gradient) for THIS slide's media frame.
   *  When set, the clip FITS (contain) and floats centered on the backdrop — for
   *  clips whose aspect doesn't match the 16:10 slot. Otherwise the clip fills. */
  bg?: string;
}
interface Props {
  slides: Slide[];
  /** Accessible name for the carousel region. */
  label?: string;
  /** Auto-advance while in view (default). `false` starts paused. */
  autoplay?: boolean;
  intervalMs?: number;
}
const {
  slides,
  label = 'Gallery',
  autoplay = true,
  intervalMs = 5000,
} = Astro.props;
const count = slides.length;
---
<section
  class="scar"
  data-autoplay={autoplay ? 'true' : 'false'}
  data-interval={intervalMs}
  data-playing="false"
  aria-roledescription="carousel"
  aria-label={label}
  style={`--scar-dur: ${intervalMs}ms`}
>
  <div class="scar-vp">
    {/* Slides are divs, not list items: role="group" isn't an allowed role on
        <li> (axe: aria-allowed-role), and overriding it would break the list's
        own semantics. This is the APG carousel pattern. */}
    <div class="scar-track">
      {slides.map((s, i) => (
        <div
          class="scar-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${count}${s.title ? ` — ${s.title}` : ''}`}
        >
          <div
            class="scar-media"
            data-showcase={s.bg ? 'true' : undefined}
            style={s.bg ? `--scar-media-bg: ${s.bg}` : undefined}
          >
            {s.video ? (
              <video
                class="scar-video"
                src={s.video}
                poster={s.poster}
                muted
                playsinline
                preload="metadata"
                aria-label={s.imageAlt ?? s.label ?? s.title}
              ></video>
            ) : s.image ? (
              <img
                class="scar-img"
                src={s.image}
                alt={s.imageAlt ?? s.label ?? s.title}
                width={s.width}
                height={s.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <ScreenshotPlaceholder label={s.label ?? s.title} aspect="16 / 10" kind="browser" />
            )}
          </div>
          <div class="scar-cap">
            {s.eyebrow && <span class="scar-eyebrow">{s.eyebrow}</span>}
            <h4 class="scar-title">{s.title}</h4>
            {s.parts ? (
              <dl class="scar-parts">
                {s.parts.map((pt) => (
                  <div class="scar-part">
                    <dt>{pt.label}</dt>
                    <dd>{pt.text}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="scar-body">{s.body}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="scar-foot">
    <button class="scar-btn scar-prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <ol class="scar-dots">
      {slides.map((s, i) => (
        <li>
          <button
            class="scar-dot"
            type="button"
            data-i={i}
            aria-label={`Go to slide ${i + 1}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ></button>
        </li>
      ))}
    </ol>
    <button class="scar-btn scar-next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="scar-btn scar-play" type="button" aria-label="Play automatically" aria-pressed="false">
      <svg class="scar-ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
      <svg class="scar-ic-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/></svg>
      <svg class="scar-ic-replay" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 12a8 8 0 1 0 2.5-5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.5 4v4h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <p class="scar-status" aria-live="polite"></p>
</section>

<style>
  .scar {
    position: relative;
    width: calc(100vw - var(--sbw));
    /* --scar-cl is the content column's LEFT offset from the viewport. The band's
       pull and the first card's inset are BOTH derived from it, so the card always
       aligns to the column and the band reaches the exact viewport edges. The JS
       sets it precisely (scrollbar-proof); this max() is a close first-paint
       fallback. */
    --scar-cl: max(var(--pad-page-x), calc(50vw - var(--max-content) / 2 + var(--pad-page-x)));
    margin-left: calc(-1 * var(--scar-cl));
    margin-right: calc(-1 * var(--scar-cl));
    padding-block: var(--space-10);
    --scar-gap: var(--space-7);
    /* Each card is the content's MAX WIDTH (not the viewport). The next card then
       peeks into the freed right margin — where the TOC sat, which fades while the
       band is in view — and cards sliding off-left are clipped at the content edge. */
    --scar-card: min(
      calc(var(--max-content) - 2 * var(--pad-page-x)),
      calc(100vw - var(--sbw) - 2 * var(--pad-page-x))
    );
  }
  .scar::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--bg-secondary);
    background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
    background-size: 28px 28px;
    z-index: 0;
  }

  /* The viewport starts at the content column and clips horizontally there, so a
     card sliding off-left disappears at the content edge (empty gutter to its
     left) while the next card peeks to the right. `clip` (not hidden) leaves the
     vertical axis visible so the cards' shadows aren't cut. */
  .scar-vp {
    position: relative;
    z-index: 1;
    /* Full-bleed viewport: clips at BOTH viewport edges, so the previous card
       peeks into the left gutter and the next card peeks on the right. */
    overflow-x: clip;
    /* Swipe/drag: horizontal gestures drive the carousel; vertical gestures still
       scroll the page (pan-y). Grab cursor hints draggability on pointer devices. */
    touch-action: pan-y;
    cursor: grab;
  }
  .scar-track {
    margin: 0;
    /* Inset only the FIRST card to the content column; as cards advance, the
       previous one is left peeking in the left gutter (mirroring the right). */
    padding: 0 0 0 var(--scar-cl);
    display: flex;
    gap: var(--scar-gap);
    /* translate is set in px by the script (the per-slide step is measured from
       layout, so it stays correct on resize); we only animate it here. */
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* While a slide is dragged the track follows the pointer 1:1 (no easing) and
     text can't be selected under it. */
  .scar.is-dragging .scar-vp { cursor: grabbing; user-select: none; }
  .scar.is-dragging .scar-track { transition: none; }
  .scar-slide {
    flex: 0 0 var(--scar-card);
    box-sizing: border-box;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-5), 2.2vw, var(--space-8));
    display: grid;
    /* Media takes the lion's share so the demo reads clearly; the caption holds
       the short rationale beside it. */
    grid-template-columns: 1.9fr 1fr;
    gap: clamp(var(--space-5), 2vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 860px) {
    .scar-slide { grid-template-columns: 1fr; gap: var(--space-5); }
  }

  .scar-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  .scar-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }
  /* Showcase mode: the media is a gradient frame (set per-carousel via
     --scar-media-bg) and the clip FITS inside it (contain), floating centered —
     so it's never cropped and the brand backdrop shows around it. */
  .scar-media[data-showcase="true"] {
    aspect-ratio: 16 / 10;
    background: var(--scar-media-bg, var(--bg-secondary));
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    overflow: hidden;
  }
  /* Video frames: one cell the size of the padded box, so the clip's
     max-height: 100% resolves and it scales down to fit, centered both ways (an
     auto row grows to the clip's own height and pushes it toward the bottom).
     Image frames keep the auto row on purpose (Zhen, 2026-10-23). */
  .scar-media[data-showcase="true"]:has(> .scar-video) {
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
  }
  .scar-media[data-showcase="true"] .scar-video,
  .scar-media[data-showcase="true"] .scar-img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    border: none;
    border-radius: var(--radius-lg);
    background: transparent;
  }
  .scar-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .scar-title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    line-height: var(--lh-title);
    letter-spacing: -0.012em;
    color: var(--ink-primary);
    margin: var(--space-3) 0 var(--space-4);
    font-weight: 500;
  }
  .scar-body {
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink-secondary);
    margin: 0;
    max-width: 46ch;
  }
  .scar-parts { margin: 0; display: grid; gap: var(--space-4); max-width: 46ch; }
  .scar-part { padding-top: var(--space-3); border-top: 1px solid var(--rule); }
  .scar-part dt {
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .scar-part dd { margin: 0; font-size: var(--fs-card); line-height: var(--lh-card); color: var(--ink-secondary); }
  .scar-part:last-child dt { color: var(--accent-ink); }
  .scar-part:last-child dd { color: var(--ink-primary); }

  /* Controls — aligned to the content column (under the card's left edge). */
  .scar-foot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .scar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--bg-primary);
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-primary);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .scar-btn:hover {
    background: var(--bg-secondary);
    border-color: var(--ink-tertiary);
  }
  .scar-btn svg { width: 16px; height: 16px; }
  .scar-play { margin-left: var(--space-4); }
  .scar-ic-pause, .scar-ic-replay { display: none; }
  .scar[data-playing="true"] .scar-ic-play { display: none; }
  .scar[data-playing="true"] .scar-ic-pause { display: block; }
  /* Reached the end — offer a replay instead of looping back automatically. */
  .scar[data-ended] .scar-ic-play,
  .scar[data-ended] .scar-ic-pause { display: none; }
  .scar[data-ended] .scar-ic-replay { display: block; }

  .scar-dots {
    list-style: none;
    margin: 0 var(--space-2);
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .scar-dots li { display: flex; }
  .scar-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--rule);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .scar-dot[aria-current="true"] {
    width: 30px;
    background: var(--accent-soft);
  }
  .scar-dot[aria-current="true"]::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--accent);
    border-radius: 999px;
  }
  .scar[data-playing="true"] .scar-dot[aria-current="true"]::after {
    animation: scar-fill var(--scar-dur, 5000ms) linear forwards;
  }
  /* Off-screen / hover / focus / drag freezes the progress in place (no reset). */
  .scar[data-frozen] .scar-dot[aria-current="true"]::after {
    animation-play-state: paused;
  }
  @keyframes scar-fill {
    from { width: 0; }
    to { width: 100%; }
  }

  .scar-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .scar-track { transition: none; }
    .scar[data-playing="true"] .scar-dot[aria-current="true"]::after { animation: none; }
  }
</style>

<script>
  /** Wires one carousel; returns its teardown (timers, observers, window listeners). */
  function initCarousel(root: HTMLElement): (() => void) | undefined {
    const vp = root.querySelector<HTMLElement>('.scar-vp');
    const track = root.querySelector<HTMLElement>('.scar-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.scar-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.scar-dot'));
    const prev = root.querySelector<HTMLButtonElement>('.scar-prev');
    const next = root.querySelector<HTMLButtonElement>('.scar-next');
    const playBtn = root.querySelector<HTMLButtonElement>('.scar-play');
    const status = root.querySelector<HTMLElement>('.scar-status');
    if (!vp || !track || slides.length === 0) return;
    root.dataset.scarReady = 'true';

    const ac = new AbortController();
    const on = { signal: ac.signal };
    const count = slides.length;
    const interval = Number(root.dataset.interval) || 5000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let i = 0;
    // The reader's intent: auto-advance (the default) until they press Pause.
    // Reduced motion starts paused, but Play still works.
    let playing = root.dataset.autoplay === 'true' && !reduce;
    let ended = false; // auto-advance reached the last slide: offer Replay, never loop
    // Transient waits. The timer runs only while `playing` and none of these is on;
    // when the last one lifts it resumes from where the progress froze.
    const hold = { offscreen: true, hover: false, focus: false, drag: false };
    let remaining = interval; // ms left in the current slide's cycle
    let cycleStart = 0;
    let timer: number | undefined;
    // Per-slide demo clips. Muted up front so browsers permit autoplay.
    const videos = slides.map((s) => s.querySelector<HTMLVideoElement>('video'));
    videos.forEach((v) => { if (v) v.muted = true; });

    // Align the first card exactly to the content column: measure the offset from
    // the full-bleed band's left edge to the content column's left, scrollbar-proof.
    function measureCL() {
      const parent = root.parentElement;
      if (!parent) return;
      const pl = parseFloat(getComputedStyle(parent).paddingLeft) || 0;
      // The content column's left edge. Both the band's pull (margin) and the first
      // card's inset read this same value, so the card aligns to the column exactly
      // and the band reaches the true viewport edges — independent of scrollbar.
      const contentLeft = parent.getBoundingClientRect().left + pl;
      root.style.setProperty('--scar-cl', `${contentLeft}px`);
    }
    // Per-slide step (card width + gap). offsetLeft ignores transforms and reflects
    // the current layout, so it's right at first paint and after any resize.
    function step() {
      return count > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : slides[0].offsetWidth;
    }
    function applyTransform(shift = 0) {
      track!.style.transform = `translateX(${-i * step() + shift}px)`;
    }
    function relayout() {
      measureCL();
      applyTransform();
    }

    // Play the active slide's clip from the start while the band is on screen; pause
    // every other clip. Muted + reduced-motion aware; never loops (no `loop` attr).
    function syncVideos() {
      videos.forEach((v, x) => {
        if (!v) return;
        if (x === i && !hold.offscreen && !reduce) {
          v.muted = true;
          if (v.paused) {
            try { v.currentTime = 0; } catch { /* not seekable yet */ }
            const p = v.play();
            if (p && typeof p.catch === 'function') p.catch(() => {});
          }
        } else if (!v.paused) {
          v.pause();
        }
      });
    }
    function show(n: number, announce: boolean) {
      i = n;
      applyTransform();
      dots.forEach((d, x) => d.setAttribute('aria-current', x === i ? 'true' : 'false'));
      // Announce reader-driven moves only; auto-advance would talk every few seconds.
      if (announce && status) status.textContent = `Slide ${i + 1} of ${count}`;
      syncVideos();
    }

    // Single place that starts / banks the timer and reflects state on the markup.
    function sync() {
      const run = playing && !hold.offscreen && !hold.hover && !hold.focus && !hold.drag;
      if (run && timer === undefined) {
        cycleStart = Date.now();
        timer = window.setTimeout(tick, remaining);
      } else if (!run && timer !== undefined) {
        clearTimeout(timer);
        timer = undefined;
        remaining = Math.max(0, remaining - (Date.now() - cycleStart));
      }
      root.dataset.playing = String(playing);
      root.toggleAttribute('data-frozen', playing && !run);
      root.toggleAttribute('data-ended', ended);
      playBtn?.setAttribute('aria-pressed', String(playing));
      playBtn?.setAttribute(
        'aria-label',
        ended ? 'Replay from the first slide' : playing ? 'Pause automatic advance' : 'Play automatically',
      );
    }
    /** Start this slide's cycle over: full interval, progress fill from 0. */
    function resetCycle() {
      if (timer !== undefined) { clearTimeout(timer); timer = undefined; }
      remaining = interval;
      root.dataset.playing = 'false';
      void root.offsetWidth; // re-trigger the active dot's fill animation
      sync();
    }
    function tick() {
      timer = undefined;
      if (i >= count - 1) { playing = false; ended = true; sync(); return; }
      show(i + 1, false);
      resetCycle();
    }
    // Manual nav (arrows / dots / keys / drag): jump and keep going from there.
    function go(n: number) {
      ended = false;
      show((n + count) % count, true);
      resetCycle();
    }

    prev?.addEventListener('click', () => go(i - 1), on);
    next?.addEventListener('click', () => go(i + 1), on);
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.i)), on));
    playBtn?.addEventListener('click', () => {
      if (ended) { ended = false; playing = true; show(0, true); }
      else playing = !playing;
      resetCycle();
    }, on);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1); }
    }, on);

    // Hover waits only for a mouse that actually moves over the slides: content
    // scrolled under a still cursor doesn't count, and touch never "hovers".
    vp.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' && !hold.hover && (e.movementX || e.movementY)) {
        hold.hover = true;
        sync();
      }
    }, on);
    vp.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && hold.hover) { hold.hover = false; sync(); }
    }, on);
    // Keyboard focus waits (APG), except on Play itself so Play always plays.
    // Mouse clicks on the buttons focus them without :focus-visible, so they don't.
    root.addEventListener('focusin', (e) => {
      const t = e.target as HTMLElement;
      hold.focus = t !== playBtn && t.matches(':focus-visible');
      sync();
    }, on);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) { hold.focus = false; sync(); }
    }, on);

    // --- Drag / swipe (mouse + touch). Down on the slides starts a gesture; up and
    // cancel are heard on window so a release anywhere ends it (never stuck).
    let g: { id: number; x: number; y: number; dx: number; axis: '' | 'x' } | null = null;
    vp.addEventListener('dragstart', (e) => e.preventDefault(), on); // no native image drag
    vp.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      if (g && g.id !== e.pointerId) return; // a second finger mid-drag
      g = { id: e.pointerId, x: e.clientX, y: e.clientY, dx: 0, axis: '' };
      hold.drag = true;
      sync();
    }, on);
    function endGesture(e: PointerEvent) {
      if (!g || e.pointerId !== g.id) return;
      const { axis, dx } = g;
      g = null;
      hold.drag = false;
      root.classList.remove('is-dragging');
      if (!axis) { sync(); return; }
      const threshold = Math.min(72, step() * 0.18);
      if (dx <= -threshold && i < count - 1) go(i + 1);
      else if (dx >= threshold && i > 0) go(i - 1);
      else { applyTransform(); sync(); } // didn't cross the threshold: snap back
    }
    window.addEventListener('pointermove', (e) => {
      if (!g || e.pointerId !== g.id) return;
      // Button released where we couldn't hear it (outside the window): end here.
      if (e.pointerType === 'mouse' && !(e.buttons & 1)) { endGesture(e); return; }
      const dx = e.clientX - g.x;
      const dy = e.clientY - g.y;
      if (!g.axis) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        // A vertical gesture is a page scroll: let it go and resume.
        if (Math.abs(dx) <= Math.abs(dy)) { endGesture(e); return; }
        g.axis = 'x';
        root.classList.add('is-dragging');
        window.getSelection()?.removeAllRanges();
        try { vp.setPointerCapture(g.id); } catch { /* pointer already gone */ }
      }
      e.preventDefault();
      g.dx = dx;
      // Rubber-band resistance at the first / last slide.
      const edge = (i === 0 && dx > 0) || (i === count - 1 && dx < 0);
      applyTransform(edge ? dx * 0.35 : dx);
    }, on);
    window.addEventListener('pointerup', endGesture, on);
    window.addEventListener('pointercancel', endGesture, on);

    // Trackpad two-finger swipe: one slide per gesture. Momentum keeps sending
    // wheel events, so a gesture ends only after a short quiet gap.
    let wheelDx = 0;
    let wheelDone = false;
    let wheelQuiet: ReturnType<typeof setTimeout> | undefined;
    vp.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return; // vertical: page scroll
      e.preventDefault();
      clearTimeout(wheelQuiet);
      wheelQuiet = setTimeout(() => { wheelDx = 0; wheelDone = false; }, 200);
      if (wheelDone) return;
      wheelDx += e.deltaMode === 1 ? e.deltaX * 16 : e.deltaX; // lines → px
      if (Math.abs(wheelDx) < 40) return;
      wheelDone = true;
      if (wheelDx > 0 && i < count - 1) go(i + 1);
      else if (wheelDx < 0 && i > 0) go(i - 1);
    }, { ...on, passive: false });

    const io = new IntersectionObserver(([en]) => {
      // "In view" = the slides reach the middle 60% of the viewport.
      hold.offscreen = !en.isIntersecting;
      syncVideos();
      sync();
    }, { rootMargin: '-20% 0px -20% 0px' });
    io.observe(vp);

    let rAF = 0;
    const scheduleRelayout = () => {
      cancelAnimationFrame(rAF);
      rAF = requestAnimationFrame(relayout);
    };
    window.addEventListener('resize', scheduleRelayout, on);
    // The content column's width can change without a window resize event (e.g. the
    // TOC column collapsing at a breakpoint, or a programmatic viewport change), so
    // observe the parent directly — it's the source of truth for --scar-cl.
    const ro = new ResizeObserver(scheduleRelayout);
    if (root.parentElement) ro.observe(root.parentElement);

    relayout();
    show(0, false);
    sync();

    return () => {
      ac.abort();
      io.disconnect();
      ro.disconnect();
      cancelAnimationFrame(rAF);
      if (timer !== undefined) clearTimeout(timer);
      clearTimeout(wheelQuiet);
    };
  }

  // Astro's ClientRouter evaluates this module once per visit, so a plain run would
  // leave carousels on later pages (case → case, or coming back) dead. Initialise
  // on every page-load (the first load included; data-scar-ready skips repeats)
  // and tear the old page's carousels down before the swap.
  let teardowns: (() => void)[] = [];
  function initAll() {
    document.querySelectorAll<HTMLElement>('.scar:not([data-scar-ready])').forEach((root) => {
      const stop = initCarousel(root);
      if (stop) teardowns.push(stop);
    });
  }
  initAll();
  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', () => {
    teardowns.forEach((stop) => stop());
    teardowns = [];
  });
</script>
