---
interface CritiqueRow {
  label: string;
  heading: string;
  /** The changes made in response — rendered as a bulleted list. */
  changes: string[];
  image: { src: string; alt: string; width?: number; height?: number };
}
interface Props { rows: CritiqueRow[]; }
const { rows } = Astro.props;
---
<div class="critiques">
  {rows.map((row) => (
    <div class="critique">
      <div>
        <div class="critique-label">{row.label}</div>
        <h4>{row.heading}</h4>
        <p class="critique-changes-lead">Changes</p>
        <ul class="critique-changes">
          {row.changes.map((c) => <li set:html={c} />)}
        </ul>
      </div>
      <div class="critique-thumb" data-zoomable>
        <img
          src={row.image.src}
          alt={row.image.alt}
          width={row.image.width}
          height={row.image.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  ))}
</div>
<style>
  /* ported from case-study-twilio.html .critiques / .critique / .critique-thumb,
     tokenized (post-review version: vertical stack, text-left/image-right). */
  .critiques {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    margin: 0 0 var(--space-9);
  }
  .critique {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-8);
    align-items: start;
  }
  .critique > div:first-child .critique-label {
    display: block;
    margin-bottom: var(--space-3);
  }
  .critique > div:first-child h4 {
    margin: 0 0 var(--space-4);
  }
  .critique > div:first-child .critique-fix {
    margin: 0;
  }
  .critique-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .critique h4 {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.25;
    margin: 0;
    font-weight: 500;
    color: var(--ink-primary);
  }
  .critique-changes-lead {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: var(--space-3) 0 var(--space-2);
  }
  .critique-changes {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
  .critique-changes li {
    position: relative;
    padding-left: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .critique-changes li:last-child { margin-bottom: 0; }
  .critique-changes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 1px;
    background: var(--ink-quaternary);
  }
  .critique-changes :global(strong) {
    color: var(--ink-primary);
    font-weight: 500;
  }
  /* image-right thumb — carries data-zoomable for the lightbox */
  .critique-thumb {
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .critique-thumb:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  /* Show the full critique screenshot at its natural ratio — never cropped.
     (These are tall portrait captures; a forced 4/3 crop cut them off.) */
  .critique-thumb img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
