---
interface Props { currentPath?: string; }
const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/off-screen', label: 'Off-screen' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<nav class="nav" aria-label="Primary" data-scroll-reveal={currentPath === '/' ? '' : undefined}>
  {/* Brand lockup in the top-left: the ZW mark + wordmark. The mark art is
      decorative; the link carries the accessible "Zhen Wang" name. */}
  <a class="nav-name" href="/">
    <img class="nav-mark" src="/logo.svg" alt="" aria-hidden="true" width="28" height="28" />
    {/* On narrow screens the wordmark drops (the mark alone still links home)
        so the four nav links never wrap mid-word — kept in the DOM (just
        visually hidden) so the accessible name is unchanged. */}
    <span class="nav-name-text">Zhen Wang</span>
  </a>
  <ul class="nav-links">
    {links.map((l) => (
      <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
    ))}
  </ul>
</nav>
<style>
  /* Full-width bar: brand lockup near the left gutter, links near the right. */
  .nav {
    display: flex; flex-wrap: nowrap; justify-content: space-between; align-items: center;
    padding: var(--space-5) var(--pad-page-x);
    border-bottom: 1px solid var(--rule);
  }
  .nav[data-scroll-reveal] {
    position: sticky; top: 0; z-index: 60;
    background: var(--bg-primary);
    transition: transform 0.2s ease;
  }
  .nav[data-scroll-reveal].is-hidden:not(:focus-within) { transform: translateY(-100%); }
  .nav[data-scroll-reveal]:focus-within { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .nav[data-scroll-reveal] { transition: none; }
  }
  .nav-name {
    display: inline-flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-display); font-size: 18px; font-weight: 500; text-decoration: none;
    flex-shrink: 0;
  }
  .nav-name-text { white-space: nowrap; }
  .nav-mark { display: block; width: 28px; height: 28px; flex-shrink: 0; }
  .nav-links {
    display: flex; gap: var(--space-7); list-style: none; margin: 0; padding: 0; font-size: 13px;
    flex-wrap: nowrap;
  }
  .nav-links li { white-space: nowrap; }
  .nav-links a { text-decoration: none; color: var(--ink-primary); }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a[aria-current="page"] { color: var(--accent); }
  @media (max-width: 767px) {
    .nav-links { gap: var(--space-4); }
    .nav-mark { width: 24px; height: 24px; }
  }
  /* Below phone width, "Zhen Wang" + all 4 links no longer fit on one line —
     drop the wordmark (the mark alone still links home) and tighten the
     links so the bar stays a single row instead of wrapping mid-word. */
  @media (max-width: 480px) {
    .nav { padding-inline: var(--space-4); }
    .nav-name-text {
      position: absolute !important;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%);
      border: 0;
    }
    .nav-links { gap: var(--space-3); font-size: 12px; }
  }
</style>

<script>
  function initScrollNav() {
    const nav = document.querySelector<HTMLElement>('.nav[data-scroll-reveal]');
    if (!nav || nav.dataset.ready) return;
    nav.dataset.ready = 'true';
    const events = new AbortController();
    let lastY = Math.max(0, window.scrollY);
    let travel = 0;

    window.addEventListener('scroll', () => {
      const y = Math.max(0, window.scrollY);
      const delta = y - lastY;
      lastY = y;
      if (y <= nav.offsetHeight) {
        nav.classList.remove('is-hidden');
        travel = 0;
        return;
      }
      // Require a deliberate movement in one direction to avoid flickering.
      if (Math.sign(delta) !== Math.sign(travel)) travel = 0;
      travel += delta;
      if (Math.abs(travel) >= 12) {
        nav.classList.toggle('is-hidden', travel > 0);
        travel = 0;
      }
    }, { passive: true, signal: events.signal });

    document.addEventListener('astro:before-swap', () => events.abort(), { once: true, signal: events.signal });
  }
  initScrollNav();
  document.addEventListener('astro:page-load', initScrollNav);
</script>
