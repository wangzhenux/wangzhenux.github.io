---
interface Props {
  heading?: string;
}
const { heading = 'Reach me' } = Astro.props;
const contacts = [
  { label: 'Email', value: 'wangzhen614@gmail.com', href: 'mailto:wangzhen614@gmail.com', external: false },
  { label: 'LinkedIn', value: 'in/zhenwang614', href: 'https://www.linkedin.com/in/zhenwang614', external: true },
  { label: 'Instagram', value: '@zhen.wang', href: 'https://www.instagram.com/zhen.wang/', external: true },
];
---
<section class="section section--last" aria-labelledby="reach-heading">
  <h2 class="section-h2" id="reach-heading">{heading}</h2>
  <ul class="reach">
    {contacts.map((c) => (
      <li>
        <a
          class="reach-card"
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener' : undefined}
        >
          <span class="label">{c.label}</span>
          <span class="value">{c.value}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  /* ported from about-resume.html .section / .reach, tokenized.
     The mockup used hover-only divs; here each card is a real anchor so it is
     keyboard-focusable and the hover affordance maps to a true link. */
  .section {
    padding: var(--space-12) var(--pad-page-x);
    border-bottom: 1px solid var(--rule);
  }
  .section--last {
    border-bottom: none;
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-7);
    font-weight: 500;
    position: relative;
  }
  .section-h2::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--accent);
    margin-bottom: var(--space-4);
  }
  .reach {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reach-card {
    display: block;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .reach-card .label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-2);
  }
  .reach-card .value {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink-primary);
    transition: color 0.2s ease;
  }
  .reach-card:hover,
  .reach-card:focus-visible {
    border-color: var(--accent);
  }
  .reach-card:hover .value,
  .reach-card:focus-visible .value {
    color: var(--accent);
  }
  @media (max-width: 767px) {
    .section {
      padding: var(--space-11) var(--pad-page-x);
    }
    .reach {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
