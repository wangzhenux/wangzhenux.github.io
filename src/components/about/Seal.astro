---
interface Props {
  /** Whether public/seal.svg exists. Computed by the page via import.meta.glob. */
  hasSeal: boolean;
}
const { hasSeal } = Astro.props;
---
{hasSeal ? (
  <img class="seal" src="/seal.svg" alt="Zhen Wang seal" width="96" height="96" />
) : (
  <span class="seal seal--fallback" aria-label="Zhen Wang">Z</span>
)}
<style>
  .seal {
    display: block;
    width: 96px;
    height: 96px;
  }
  .seal--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 64px;
    line-height: 1;
    font-weight: 500;
  }
</style>
