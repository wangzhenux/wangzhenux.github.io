---
interface EducationItem {
  /** Primary line, e.g. a degree or field of study. */
  primary: string;
  /** Optional supporting detail (institution, focus, year). */
  detail?: string;
}
interface Props {
  heading?: string;
  /** Education entries. Only real, sourced lines should be passed. */
  education: EducationItem[];
}
const { heading = 'Education & practice', education } = Astro.props;
---
<section class="section" aria-labelledby="edu-heading">
  <h2 class="section-h2" id="edu-heading">{heading}</h2>
  <div class="two-col">
    <div>
      <h3 class="two-col-h3">Education</h3>
      {education.map((e) => (
        <p class="edu-line">
          <strong>{e.primary}</strong>{e.detail && <span class="edu-detail"> · {e.detail}</span>}
        </p>
      ))}
    </div>
    <div>
      <h3 class="two-col-h3">How I work</h3>
      <p>
        My work sits where design meets engineering. I design and systematize in
        Figma, move fast from concept to interface with AI tools like Google
        Stitch, and prototype in real, working code with Claude Code — so what I
        propose is grounded in what's actually buildable, not just a static mock.
        Most of my decade has been on dense, expert software — developer tools,
        enterprise platforms, and increasingly AI-assisted products — where the
        work is making complexity feel obvious. When the team needs ground truth
        I run usability sessions; when an idea is hard to explain, I draw it.
      </p>
    </div>
  </div>
</section>
<style>
  /* ported from about-resume.html .section / .two-col, tokenized */
  .section {
    padding: var(--space-12) var(--pad-page-x);
    max-width: var(--max-content);
    margin-inline: auto;
    border-bottom: 1px solid var(--rule);
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-7);
    font-weight: 500;
    position: relative;
  }
  .section-h2::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--accent);
    margin-bottom: var(--space-4);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
  }
  .two-col-h3 {
    font-family: var(--font-display);
    font-size: 17px;
    margin: 0 0 var(--space-3);
    font-weight: 500;
  }
  .two-col p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-secondary);
    margin: 0 0 var(--space-3);
  }
  .edu-line strong {
    color: var(--ink-primary);
    font-weight: 500;
  }
  .edu-detail {
    color: var(--ink-tertiary);
  }
  @media (max-width: 767px) {
    .section {
      padding: var(--space-11) var(--pad-page-x);
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
