---
interface Company {
  /** Employer, e.g. "Twilio". */
  company: string;
  /** Role(s) held there, e.g. "Design Lead · Senior UX Designer". */
  title: string;
  /** Optional monochrome logo served from /public. Falls back to text only. */
  logo?: string;
}
interface Props {
  companies: Company[];
  heading?: string;
}
const { companies, heading = "Where I've been" } = Astro.props;
---
<section class="section" aria-labelledby="history-heading">
  <h2 class="section-h2" id="history-heading">{heading}</h2>
  <ul class="history">
    {companies.map((c) => (
      <li class="history-row">
        <div class="history-meta">
          <span class="history-company">{c.company}</span>
          <span class="history-role">{c.title}</span>
        </div>
        {c.logo && (
          <img class="history-logo" src={c.logo} alt="" aria-hidden="true" height="24" loading="lazy" decoding="async" />
        )}
      </li>
    ))}
  </ul>
</section>
<style>
  /* ported from about-resume.html .section / .history, tokenized */
  .section {
    padding: var(--space-12) var(--pad-page-x);
    max-width: var(--max-content);
    margin-inline: auto;
    border-bottom: 1px solid var(--rule);
  }
  .section-h2 {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-7);
    font-weight: 500;
    position: relative;
  }
  .section-h2::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--accent);
    margin-bottom: var(--space-4);
  }
  .history {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .history-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .history-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  /* Employer wordmark as a quiet right-aligned accent, knocked back to one ink
     tone (which also rescues the light Rackspace mark on the cream surface). */
  .history-logo {
    height: 24px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    object-position: right center;
    filter: brightness(0);
    opacity: 0.65;
    flex-shrink: 0;
  }
  .history-company {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink-primary);
    font-weight: 500;
  }
  .history-role {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  @media (max-width: 767px) {
    .section {
      padding: var(--space-11) var(--pad-page-x);
    }
  }
</style>
