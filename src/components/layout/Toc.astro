---
interface Section { id: string; num: string; label: string; }
interface Props { sections: Section[]; }
const { sections } = Astro.props;
---
<aside class="toc" aria-label="Case study sections">
  <ul class="toc-list">
    {sections.map((s) => (
      <li>
        <button type="button" class="toc-item" data-target={s.id}>
          <span class="dot" aria-hidden="true"></span>
          <span class="num">{s.num}</span>
          <span class="toc-label">{s.label}</span>
        </button>
      </li>
    ))}
  </ul>
</aside>
<style>
  .toc {
    position: sticky;
    top: var(--space-6);
    align-self: start;
    padding-top: var(--space-11);
    font-family: var(--font-mono);
    font-size: 11px;
    transition: opacity 0.3s ease, visibility 0.3s;
  }
  .toc.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  /* Border-left lives on the list itself so it matches the height of the items only,
     not the padding-top above. */
  .toc-list {
    list-style: none;
    padding: 0 0 0 var(--space-5);
    margin: 0;
    border-left: 1px solid var(--rule);
  }
  .toc-list li { list-style: none; }
  .toc-item {
    display: flex; align-items: baseline; gap: var(--space-2);
    padding: var(--space-1) var(--space-2) var(--space-1) 0;
    margin: 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink-tertiary);
    line-height: 1.35;
    transition: color 0.2s;
    font-family: var(--font-mono);
    font-size: 11px;
    width: 100%;
    border-radius: 3px;
  }
  .toc-item:hover { color: var(--ink-primary); }
  .toc-item .num {
    font-size: 9px;
    color: var(--ink-quaternary);
    flex-shrink: 0;
    width: 14px;
    letter-spacing: 0.08em;
  }
  .toc-item[aria-current="location"],
  .toc-item.active {
    color: var(--accent);
    font-weight: 500;
  }
  .toc-item[aria-current="location"] .num,
  .toc-item.active .num { color: var(--accent); }

  /* The dot marker is only used in the thin (1024–1279) column treatment. */
  .toc-item .dot { display: none; }

  /* === 1024–1279: thin TOC column ===
     Collapse to dots + numbers; the section name reveals on hover/focus as a
     small floating label so the column stays narrow but remains usable. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .toc { padding-top: var(--space-8); font-size: 9px; }
    .toc-list { padding-left: var(--space-3); }
    .toc-item {
      position: relative;
      gap: var(--space-2);
      padding: var(--space-1) 0;
    }
    .toc-item .dot {
      display: block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--ink-quaternary);
      flex-shrink: 0;
      transition: background 0.2s;
    }
    .toc-item .num { width: auto; }
    .toc-item[aria-current="location"] .dot,
    .toc-item.active .dot { background: var(--accent); }
    /* Hide the full label; reveal it on hover/focus as a floating popover. */
    .toc-label {
      position: absolute;
      right: calc(100% + var(--space-3));
      top: 50%;
      transform: translateY(-50%);
      white-space: nowrap;
      background: var(--bg-inverse);
      color: var(--ink-on-dark);
      padding: var(--space-1) var(--space-3);
      border-radius: 4px;
      font-size: 11px;
      box-shadow: var(--shadow-card);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.15s ease;
      z-index: 20;
    }
    .toc-item:hover .toc-label,
    .toc-item:focus-visible .toc-label {
      opacity: 1;
      visibility: visible;
    }
  }
</style>
