---
// Top progress bar + current-section tag + TOC drawer (§9.1).
// Shown at ALL widths now — the sidebar TOC was removed so the body owns the full
// content width, and this sticky top bar is the case study's section nav. The thin
// accent bar reflects scroll % of the article; the section tag ("03 / 07 · One
// search, two modes") and the drawer list are driven by the active-section logic in
// toc-scrollspy.ts. The drawer is a disclosure: the tag carries aria-expanded and
// the panel lists the same .toc-item buttons (same data-target) for click-to-scroll.
import Icon from '../chrome/Icon.astro';
interface Section { id: string; num: string; label: string; }
interface Props { sections: Section[]; }
const { sections } = Astro.props;
const total = String(sections.length).padStart(2, '0');
---
<div class="progress-bar" data-total={total}>
  <div class="progress-track" aria-hidden="true">
    <div class="progress-fill"></div>
  </div>
  <div class="progress-inner">
    <button
      type="button"
      class="progress-tag"
      aria-expanded="false"
      aria-controls="toc-drawer"
      aria-label="Show case study sections"
    >
      <span class="progress-count"><span class="progress-current">01</span> / {total}</span>
      <span class="progress-sep" aria-hidden="true">·</span>
      <span class="progress-label">{sections[0]?.label ?? ''}</span>
      <span class="progress-chevron" aria-hidden="true"><Icon name="chevron-down" size={12} /></span>
    </button>
    <div id="toc-drawer" class="progress-drawer" hidden>
      <ul class="progress-drawer-list">
        {sections.map((s) => (
          <li>
            <button type="button" class="toc-item toc-item--drawer" data-target={s.id}>
              <span class="num">{s.num}</span>{s.label}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
<style>
  /* Fixed at the top, but hidden over the hero — the scrollspy island adds
     .is-visible once the hero is scrolled past, so the bar slides in only when the
     case content begins (never competing with the title/cover). */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-2) 0 var(--space-3);
    transform: translateY(-100%);
    transition: transform 0.28s ease;
  }
  .progress-bar.is-visible { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .progress-bar { transition: none; }
  }
  .progress-track {
    height: 2px;
    background: var(--rule);
    position: relative;
    margin: 0 0 var(--space-2);
    overflow: hidden;
  }
  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: var(--accent);
    transition: width 0.15s linear;
  }
  .progress-inner {
    max-width: var(--max-content);
    margin-inline: auto;
    padding-inline: var(--pad-page-x);
  }
  .progress-tag {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    width: 100%;
    background: none;
    border: none;
    padding: var(--space-1) 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-tertiary);
    border-radius: var(--radius-sm);
  }
  .progress-count { color: var(--accent); flex-shrink: 0; }
  .progress-sep { color: var(--ink-quaternary); flex-shrink: 0; }
  .progress-label {
    color: var(--ink-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .progress-chevron {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
    color: var(--ink-tertiary);
    transition: transform 0.2s ease;
  }
  .progress-tag[aria-expanded="true"] .progress-chevron { transform: rotate(180deg); }

  .progress-drawer {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  .progress-drawer[hidden] { display: none; }
  .progress-drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-1) var(--space-7);
  }
  .toc-item--drawer {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    background: none;
    border: none;
    padding: var(--space-2) 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.35;
    color: var(--ink-secondary);
    border-radius: var(--radius-sm);
  }
  .toc-item--drawer:hover { color: var(--ink-primary); }
  .toc-item--drawer .num {
    font-size: 10px;
    color: var(--ink-quaternary);
    flex-shrink: 0;
    width: 16px;
    letter-spacing: 0.08em;
  }
  .toc-item--drawer[aria-current="location"],
  .toc-item--drawer.active { color: var(--accent); font-weight: 500; }
  .toc-item--drawer[aria-current="location"] .num,
  .toc-item--drawer.active .num { color: var(--accent); }

  @media (max-width: 700px) {
    .progress-drawer-list { grid-template-columns: 1fr; }
  }
</style>
