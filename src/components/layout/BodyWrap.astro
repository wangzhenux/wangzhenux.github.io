<div class="body-wrap">
  <div class="body"><slot /></div>
</div>
<style>
  /* The sidebar TOC was removed (§9.1): the top progress bar is the section nav at
     all widths, and the body now owns the FULL content frame — no column reserved
     where the TOC used to sit. Prose, meta, and the full-bleed showcases all share
     the same left/right content edges. */
  .body-wrap { max-width: var(--max-content); margin: 0 auto;
               padding: 0 var(--pad-page-x) var(--space-12); }
  .body { min-width: 0; }
</style>
