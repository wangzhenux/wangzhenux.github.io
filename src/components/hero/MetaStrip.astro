---
interface Field { label: string; value: string; sub?: string; }
interface Props { fields: Field[]; }
const { fields } = Astro.props;
---
<dl class="meta-strip" style={`--meta-cols: ${fields.length}`}>
  {fields.map((f) => (
    <div>
      <dt class="label">{f.label}</dt>
      <dd class="value">{f.value}</dd>
      {f.sub && <dd class="sub">{f.sub}</dd>}
    </div>
  ))}
</dl>
<style>
  /* ported from case-study-twilio.html .meta-strip, tokenized.
     Columns auto-fit to N fields via --meta-cols (§12.10). */
  .meta-strip {
    display: grid;
    grid-template-columns: repeat(var(--meta-cols), 1fr);
    gap: var(--space-7);
    padding: var(--space-5) 0 var(--space-7);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 12px;
    margin: 0;
  }
  .meta-strip div { margin: 0; }
  .meta-strip .label {
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
    margin: 0 0 var(--space-2);
  }
  .meta-strip .value {
    color: var(--ink-primary);
    line-height: 1.5;
    margin: 0;
    font-weight: 500;
  }
  /* Secondary line under a value — e.g. team context beneath the highlighted role. */
  .meta-strip .sub {
    color: var(--ink-tertiary);
    line-height: 1.5;
    font-size: 11px;
    margin: var(--space-1) 0 0;
  }

  /* Responsive column collapse (§9.1). min() caps the columns at the breakpoint
     ceiling while never exceeding the actual field count (--meta-cols). */
  @media (max-width: 1279px) {
    .meta-strip { grid-template-columns: repeat(min(var(--meta-cols), 3), 1fr); }
  }
  @media (max-width: 1023px) {
    .meta-strip {
      grid-template-columns: repeat(min(var(--meta-cols), 2), 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 767px) {
    .meta-strip {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
