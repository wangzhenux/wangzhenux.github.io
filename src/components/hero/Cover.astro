---
interface Props {
  caseCover?: string;
  image?: string;
  alt: string;
  width?: number;
  height?: number;
}
const { caseCover, image, alt, width, height } = Astro.props;
---
{image ? (
  <img
    class="cover cover-image"
    src={image}
    alt={alt}
    width={width}
    height={height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
) : (
  <div class="cover" style={`--case-cover: ${caseCover}`} role="img" aria-label={alt}></div>
)}
<style>
  /* Contained, rounded hero cover (the hero sits in the shared content frame,
     so the cover keeps a gutter on the left/right and rounded corners). */
  .cover {
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  /* Gradient placeholder cover (no real image): fixed banner ratio. */
  div.cover {
    aspect-ratio: 16/8;
    background:
      radial-gradient(at 25% 25%, var(--cover-sheen), transparent 50%),
      var(--case-cover);
    position: relative;
  }
  /* Real cover image: natural ratio, never cropped. The illustration SVGs are
     authored at 16:10 so the hero shows the whole composition. */
  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    background: none;
  }

  /* Gradient placeholder aspect-ratio swaps per breakpoint (§9.3). */
  @media (max-width: 1023px) {
    div.cover { aspect-ratio: 16/9; }
  }
  @media (max-width: 767px) {
    div.cover { aspect-ratio: 4/3; }
  }
</style>
