---
import Cover from './Cover.astro';
import MetaStrip from './MetaStrip.astro';
import Container from '../layout/Container.astro';

interface MetaField { label: string; value: string; }
interface CoverProps { caseCover?: string; image?: string; alt: string; }
interface Props {
  eyebrow: string;
  title: string;
  deck: string;
  cover: CoverProps;
  metaFields: MetaField[];
}
const { eyebrow, title, deck, cover, metaFields } = Astro.props;
---
<header class="hero">
  {/* Text sits in the shared content frame (same x-padding as the homepage,
      the back link, and the case body). The cover image spans full width. */}
  <Container>
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-title">{title}</h1>
    <p class="hero-deck">{deck}</p>
  </Container>
  <div class="hero-cover"><Cover {...cover} /></div>
  <Container>
    <MetaStrip fields={metaFields} />
  </Container>
</header>
<style>
  /* The hero itself is full-width so the cover can bleed edge-to-edge; the
     text + meta are constrained by the inner Container. */
  .hero {
    padding-top: var(--space-8);
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin: 0 0 var(--space-4);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-5);
    font-weight: 500;
    max-width: 18ch;
  }
  .hero-deck {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
    color: var(--ink-secondary);
    max-width: 50ch;
    margin: 0 0 var(--space-8);
  }
  /* Full-width cover (the .hero is full-width, so width:100% = viewport width),
     with breathing room before the meta strip. */
  .hero-cover {
    margin-bottom: var(--space-8);
  }
</style>
