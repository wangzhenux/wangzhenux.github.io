---
import Cover from './Cover.astro';
import MetaStrip from './MetaStrip.astro';
import Container from '../layout/Container.astro';

interface MetaField { label: string; value: string; }
interface CoverProps { caseCover?: string; image?: string; alt: string; width?: number; height?: number; frame?: 'laptop' | 'browser'; }
interface Props {
  eyebrow: string;
  title: string;
  deck: string;
  companyNote?: string;
  cover: CoverProps;
  metaFields: MetaField[];
}
const { eyebrow, title, deck, companyNote, cover, metaFields } = Astro.props;
---
<header class:list={['hero', { 'has-company-note': companyNote }]}>
  {/* Whole hero is contained in the shared content frame — text, cover, and
      meta all share the same x-padding as the homepage / back link / body.
      The cover keeps a gutter on the left/right and rounded corners. */}
  <Container>
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-title">{title}</h1>
    <p class="hero-deck">{deck}</p>
    {companyNote && <p class="hero-company-note">{companyNote}</p>}
    <div class="hero-cover"><Cover {...cover} /></div>
    <MetaStrip fields={metaFields} />
  </Container>
</header>
<style>
  .hero {
    padding-top: var(--space-8);
  }
  .hero-eyebrow,
  .hero-title,
  .hero-deck {
    text-align: center;
    text-wrap: balance;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin: 0 0 var(--space-4);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
    letter-spacing: -0.025em;
    margin: 0 auto var(--space-5);
    font-weight: 500;
    max-width: 24ch;
  }
  .hero-deck {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-deck);
    line-height: 1.4;
    color: var(--ink-secondary);
    max-width: 55ch;
    margin: 0 auto var(--space-10);
  }
  /* Full-width cover (the .hero is full-width, so width:100% = viewport width),
     with breathing room before the meta strip. */
  .hero-cover {
    margin-bottom: var(--space-8);
  }
  .hero.has-company-note .hero-deck {
    margin-bottom: var(--space-3);
  }
  .hero-company-note {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 400;
    line-height: var(--lh-small);
    color: var(--ink-tertiary);
    text-align: center;
    text-wrap: balance;
    max-width: 70ch;
    margin: 0 auto var(--space-7);
  }
  @media (max-width: 767px) {
    .hero-deck {
      margin-bottom: var(--space-8);
    }
    .hero-company-note {
      margin-bottom: var(--space-6);
    }
  }
</style>
