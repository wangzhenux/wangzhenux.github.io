---
import MetaStrip from '../hero/MetaStrip.astro';
import Container from '../layout/Container.astro';
import Icon from '../chrome/Icon.astro';

interface MetaField { label: string; value: string; }
interface Props {
  slug: string;
  title: string;
  company?: string;
  year?: number | string;
  cover?: string;
  image?: string;
  summary?: string;
  metaFields?: MetaField[];
}
const { slug, title, company, year, cover, image, summary, metaFields = [] } = Astro.props;
const eyebrow = ['Featured', year, company].filter(Boolean).join(' · ');
const href = `/work/${slug}`;
---
<section class="featured" aria-labelledby="featured-heading">
  <Container>
    <a class="featured-cover" href={href}
       style={!image ? `--case-cover: ${cover}` : undefined}>
      {image && <img class="featured-cover-image" src={image} alt="" />}
      <span class="featured-cover-content">
        <span class="featured-cover-text">
          <span class="featured-meta">{eyebrow}</span>
          <span class="featured-title" id="featured-heading">{title}</span>
        </span>
        <span class="featured-cta">Read the story <Icon name="arrow-right" size={14} /></span>
      </span>
    </a>
    {summary && <p class="featured-lead">{summary}</p>}
    {metaFields.length > 0 && <MetaStrip fields={metaFields} />}
  </Container>
</section>
<style>
  /* ported from homepage.html .featured / .featured-cover / .featured-meta /
     .featured-title / .featured-cta / .featured-lead, tokenized.
     The cover is the link; meta strip reuses the hero MetaStrip below it. */
  .featured {
    padding-block: var(--space-4) var(--space-11);
  }
  .featured-cover {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--ink-on-dark);
    margin-bottom: var(--space-7);
    background:
      radial-gradient(at 30% 20%, var(--cover-sheen), transparent 50%),
      var(--case-cover);
    text-decoration: none;
  }
  .featured-cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--cover-scrim) 0%, var(--cover-scrim) 40%, transparent 82%);
  }
  .featured-cover-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-8) var(--space-8);
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }
  .featured-cover-text {
    display: block;
  }
  .featured-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.85;
    margin-bottom: var(--space-2);
    text-shadow: var(--cover-text-shadow-sm);
  }
  .featured-title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 22ch;
    text-shadow: var(--cover-text-shadow-lg);
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--bg-primary);
    color: var(--ink-primary);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .featured-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }
  @media (max-width: 767px) {
    .featured-cover-content {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6) var(--space-5);
    }
    /* Stacked eyebrow + title + CTA runs nearly the full cover height on
       narrow screens, so the bottom-weighted gradient can't keep it clear
       of the art underneath — flatten to a uniform, stronger scrim instead. */
    .featured-cover::after {
      background: var(--cover-scrim-strong);
    }
  }
</style>
