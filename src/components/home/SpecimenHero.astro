---
import Container from '../layout/Container.astro';
import Icon from '../chrome/Icon.astro';
const film = '/video/zhen-wang-specimen.mp4';
const poster = '/video/specimen-poster.jpg';
---
<header class="home-hero" data-specimen-hero>
  <Container>
    <div class="home-intro">
      <div>
        <h1 class="home-hero-h1">Hello,<br />I'm Zhen.</h1>
        <div class="home-hero-facts">
          <p>Product designer with <strong>10+ years of experience</strong></p>
          <p>Currently <strong>Product Design Lead</strong> at Tripalink</p>
          <p>Shipping AI-native products for fast-growing teams</p>
        </div>
        <div class="home-hero-actions">
          <a class="btn btn-primary" href="mailto:wangzhen614@gmail.com">
            Contact<Icon name="arrow-up-right" size={14} />
          </a>
          <a
            class="home-hero-linkedin"
            href="https://www.linkedin.com/in/zhenwang614"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <rect x="4" y="9" width="3.5" height="11" rx="1" />
              <circle cx="5.75" cy="4.5" r="2.25" />
              <path d="M11.5 9h3.3v1.9h.05c.46-.87 1.6-1.9 3.3-1.9 3.5 0 4.15 2.3 4.15 5.3V20h-3.5v-6.1c0-1.45-.03-3.3-2.02-3.3-2.03 0-2.34 1.58-2.34 3.2V20h-3.5V9z" />
            </svg>
          </a>
          <a class="watch-film" href={film} data-play-film aria-haspopup="dialog">
            <svg class="watch-play" viewBox="0 0 32 32" width="28" height="28" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" stroke="currentColor" /><path d="m13 10 9 6-9 6Z" fill="currentColor" /></svg>
            Watch my story <span class="film-duration">· 1:16</span>
          </a>
        </div>
      </div>
      <div class="home-hero-portrait">
        <img
          src="/about/portrait.png"
          alt="A line-art portrait of Zhen Wang, resting his chin on his hand"
          width="1200"
          height="1200"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </Container>

  <dialog class="film-theater" aria-labelledby="film-title">
    <div class="theater-panel">
      <div class="theater-heading">
        <h2 id="film-title">Zhen Wang <span>/ 10 years in 76 seconds</span></h2>
        <button class="theater-close" type="button" aria-label="Close film" autofocus>
          <span>Close</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <div class="theater-picture">
        <video class="film-full" data-src={film} poster={poster} controls playsinline preload="none" aria-label="Zhen Wang — 10 years in 76 seconds"></video>
        <img class="theater-snapshot" src={poster} alt="" aria-hidden="true" width="1920" height="1080" />
        <div class="film-ended" hidden>
          <p>Let's get into the work.</p>
          <button type="button" data-film-work>Explore selected work <Icon name="arrow-down" size={16} /></button>
          <button type="button" data-film-replay>Watch again</button>
        </div>
      </div>
      <div class="theater-footer">
        <p class="film-status" role="status">Design. Engineering. A little of everything in between.</p>
        <span>01:16</span>
      </div>
    </div>
  </dialog>
</header>

<style>
  .home-intro { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: var(--space-10); padding-block: var(--space-12) var(--space-13); }
  .home-hero-portrait {
    aspect-ratio: 1 / 1;
    max-width: 560px;
    margin-left: auto;
  }
  .home-hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .home-hero-h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1-page);
    line-height: var(--lh-heading);
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-6);
    font-weight: 500;
    color: var(--ink-primary);
  }
  .home-hero-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .home-hero-facts p {
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    max-width: 580px;
    color: var(--ink-secondary);
    margin: 0;
  }
  .home-hero-facts strong {
    color: var(--ink-primary);
    font-weight: 600;
  }
  .home-hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  /* Same .btn/.btn-primary treatment as the About page's resume CTA
     (CvCallout.astro) — repeated here since Astro scopes styles per file.
     Explicit height (rather than letting padding drive it) so the square
     LinkedIn icon button next to it can match exactly. */
  .btn {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: opacity 0.2s, background 0.2s, color 0.2s;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--ink-on-dark);
  }
  .btn-primary:hover,
  .btn-primary:focus-visible {
    opacity: 0.92;
  }
  .home-hero-linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--ink-primary);
    color: var(--ink-primary);
    flex-shrink: 0;
    transition: background 0.2s, color 0.2s;
  }
  .home-hero-linkedin:hover,
  .home-hero-linkedin:focus-visible {
    background: var(--ink-primary);
    color: var(--bg-primary);
  }
  /* Text button for the film: same mono label as .btn, no fill or border, so
     Contact stays the one primary action. Opens the theater dialog below. */
  .watch-film {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-left: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-primary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .watch-film:hover,
  .watch-film:focus-visible { color: var(--accent-ink); }
  .watch-play { flex-shrink: 0; }
  .film-duration { color: var(--ink-tertiary); }

  .film-theater { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: var(--space-6); border: 0; overflow: auto; background: transparent; color: var(--ink-on-dark); }
  .film-theater[open] { display: grid; place-items: center; }
  .film-theater::backdrop { background: color-mix(in srgb, var(--bg-inverse) 97%, transparent); }
  .theater-panel { width: min(100%, 1600px, calc((100svh - 180px) * 16 / 9)); transform-origin: top left; }
  .theater-heading, .theater-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .theater-heading { margin-bottom: var(--space-4); }
  .theater-heading h2 { font: var(--fs-card) var(--font-display); }
  .theater-heading h2 span { font: var(--fs-micro) var(--font-mono); letter-spacing: 0.05em; margin-left: var(--space-3); opacity: 0.65; }
  .theater-close { display: inline-flex; align-items: center; gap: var(--space-3); min-height: 44px; padding: 0; border: none; color: inherit; background: transparent; cursor: pointer; }
  .theater-close span { font: var(--fs-micro) var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; }
  .theater-picture { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--bg-inverse); }
  .film-full, .theater-snapshot { display: block; width: 100%; height: 100%; object-fit: contain; }
  .theater-snapshot { position: absolute; inset: 0; pointer-events: none; transition: opacity 0.2s; }
  .theater-panel.is-opened.is-playing .theater-snapshot { opacity: 0; }
  .theater-footer { margin-top: var(--space-4); font: var(--fs-micro)/var(--lh-small) var(--font-mono); letter-spacing: 0.03em; opacity: 0.75; }
  .film-status { margin: 0; }
  .film-ended { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-5); background: var(--cover-scrim-strong); }
  .film-ended[hidden] { display: none; }
  .film-ended p { font: var(--fs-h2) var(--font-display); margin: 0; }
  .film-ended button { display: inline-flex; align-items: center; gap: var(--space-3); border: none; background: var(--accent); color: var(--ink-on-dark); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-5); cursor: pointer; min-height: 44px; }
  .film-ended [data-film-replay] { background: transparent; padding: 0; }
  @media (max-width: 767px) {
    .home-intro { grid-template-columns: 1fr; gap: var(--space-6); padding-block: var(--space-8); text-align: center; }
    .home-hero-facts { max-width: 36ch; margin-inline: auto; }
    .home-hero-facts p { text-wrap: balance; }
    .home-hero-actions { justify-content: center; flex-wrap: wrap; }
    .watch-film { flex-basis: 100%; justify-content: center; margin-left: 0; }
    .home-hero-portrait { order: -1; max-width: 280px; margin-inline: auto; }
    .film-theater { padding: var(--space-3); }
    .theater-panel { width: 100%; }
    .theater-heading h2 span { display: none; }
    .theater-footer { font-size: var(--fs-fig); }
  }
</style>

<script>
  import { initSpecimenHero } from '../../lib/specimen-hero';
  initSpecimenHero();
  document.addEventListener('astro:page-load', initSpecimenHero);
</script>
