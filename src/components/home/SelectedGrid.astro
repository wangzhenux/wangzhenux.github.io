---
import CaseCard from './CaseCard.astro';
import Container from '../layout/Container.astro';

interface CaseInput {
  slug: string;
  title: string;
  lead?: string;
  tags?: string[];
  brand?: string;
  logo?: string;
  logoAlt?: string;
  frame?: 'laptop' | 'browser';
  shot?: string;
  cover?: string;
  coverImage?: string;
  company?: string;
}
interface Props {
  cases: CaseInput[];
  title?: string;
}
const { cases, title = 'Selected work' } = Astro.props;
const count = cases.length;
const countLabel = String(count).padStart(2, '0');
---
{count > 0 && (
  <section class="selected" aria-labelledby="selected-heading">
    <Container>
      <div class="selected-header">
        <h2 class="selected-title" id="selected-heading">{title}</h2>
        <span class="selected-count">{countLabel} {count === 1 ? 'case' : 'cases'}</span>
      </div>
      <div class="selected-grid">
        {cases.map((c) => (
          <CaseCard {...c} />
        ))}
      </div>
    </Container>
  </section>
)}
<style>
  /* ported from homepage.html .selected / .selected-grid, tokenized.
     Two equal columns — every card renders at the same width. */
  .selected {
    padding-block: var(--space-10) var(--space-11);
    border-top: 1px solid var(--rule);
    background: var(--bg-secondary);
  }
  .selected-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-8);
  }
  .selected-title {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0;
    font-weight: 500;
  }
  .selected-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .selected-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8) var(--space-6);
  }
  @media (max-width: 767px) {
    .selected-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
