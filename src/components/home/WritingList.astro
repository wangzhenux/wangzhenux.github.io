---
import { writings } from '../../lib/writings';
import Container from '../layout/Container.astro';

interface Props {
  limit?: number;
  title?: string;
}
const { limit = 3, title = 'Writing' } = Astro.props;
const profileUrl = 'https://medium.com/@wangzhen614';
const posts = writings.slice(0, limit);
---
<section class="writing" aria-labelledby="writing-heading">
  <Container>
    <div class="writing-header">
      <h2 class="writing-title" id="writing-heading">{title}</h2>
      <a class="writing-more" href={profileUrl} target="_blank" rel="noopener">on Medium →</a>
    </div>

    <ul class="writing-list">
      {posts.map((post) => (
        <li>
          <a class="writing-row" href={post.link} target="_blank" rel="noopener">
            <img class="writing-thumb" src={post.image} alt="" loading="lazy" width="72" height="72" />
            <span class="writing-headline">{post.title}</span>
            <span class="writing-excerpt">{post.excerpt}</span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>
<style>
  /* ported from homepage.html .writing, tokenized. Curated three-up list with a
     square hero thumbnail, serif headline, and a condensed excerpt. */
  .writing {
    padding-block: var(--space-11);
  }
  .writing-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
  }
  .writing-title {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.01em;
    margin: 0;
    font-weight: 500;
  }
  .writing-more {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
  }
  .writing-more:hover,
  .writing-more:focus-visible {
    color: var(--accent);
  }
  .writing-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .writing-row {
    display: grid;
    grid-template-columns: 72px 1.1fr 1.4fr;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    color: inherit;
  }
  .writing-thumb {
    width: 72px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule-soft);
  }
  .writing-headline {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .writing-row:hover .writing-headline,
  .writing-row:focus-visible .writing-headline {
    color: var(--accent);
  }
  .writing-excerpt {
    font-size: 13px;
    color: var(--ink-tertiary);
    line-height: 1.55;
    max-width: 52ch;
  }
  @media (max-width: 767px) {
    .writing-row {
      grid-template-columns: 56px 1fr;
      gap: var(--space-3) var(--space-4);
      align-items: start;
    }
    .writing-thumb {
      width: 56px;
      grid-row: span 2;
    }
    .writing-excerpt {
      display: none;
    }
  }
</style>
