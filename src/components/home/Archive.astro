---
import Container from '../layout/Container.astro';
import Icon from '../chrome/Icon.astro';

interface ArchiveItem {
  slug: string;
  title: string;
  year?: number | string;
  context?: string;
}
interface Props {
  items: ArchiveItem[];
  title?: string;
  sub?: string;
}
const {
  items,
  title = 'Earlier work',
  sub = 'Academic and exploratory projects. Click through to read; happy to dig in if any are relevant.',
} = Astro.props;
---
{items.length > 0 && (
  <section class="archive" aria-labelledby="archive-heading">
    <Container>
      <h2 class="archive-title" id="archive-heading">{title}</h2>
      <p class="archive-sub">{sub}</p>
      <ul class="archive-list">
        {items.map((item) => (
          <li>
            <a class="archive-item" href={`/work/${item.slug}`}>
              <span class="t">{item.title}</span>
              {(item.context || item.year) && (
                <span class="y">{item.context ?? item.year}</span>
              )}
              <span class="arrow" aria-hidden="true"><Icon name="arrow-right" size={13} /></span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
)}
<style>
  /* ported from homepage.html .archive / .archive-item, tokenized.
     Quiet inline pills; hover (and keyboard focus) reveals accent + arrow. */
  .archive {
    padding-block: var(--space-9) var(--space-11);
    background: var(--bg-secondary);
    border-top: 1px solid var(--rule);
  }
  .archive-title {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: -0.005em;
    margin: 0 0 var(--space-1);
    font-weight: 500;
  }
  .archive-sub {
    font-size: 13px;
    color: var(--ink-tertiary);
    margin: 0 0 var(--space-6);
  }
  .archive-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .archive-item {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--ink-secondary);
    text-decoration: none;
    font-size: 13px;
    padding: var(--space-1) 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .archive-item:hover,
  .archive-item:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .archive-item .y {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-quaternary);
  }
  .archive-item .arrow {
    display: inline-flex;
    align-items: center;
    color: var(--ink-quaternary);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .archive-item:hover .arrow,
  .archive-item:focus-visible .arrow {
    opacity: 1;
  }
</style>
