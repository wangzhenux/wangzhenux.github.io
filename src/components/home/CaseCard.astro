---
interface Props {
  slug: string;
  title: string;
  company?: string;
  year?: number | string;
  role?: string;
  cover?: string;
  image?: string;
  summary?: string;
  large?: boolean;
}
const { slug, title, company, year, role, cover, image, summary, large } = Astro.props;
const meta = [company, year, role].filter(Boolean).join(' · ');
---
<article class:list={['case-card', { 'span-2': large }]}>
  <a class="case-link" href={`/work/${slug}`} aria-label={title}>
    {image ? (
      <img class="case-cover case-cover-image" src={image} alt="" />
    ) : (
      <span class="case-cover" style={`--case-cover: ${cover}`} aria-hidden="true"></span>
    )}
  </a>
  {meta && <p class="case-meta">{meta}</p>}
  <h3 class="case-title"><a href={`/work/${slug}`}>{title}</a></h3>
  {summary && <p class="case-summary">{summary}</p>}
</article>
<style>
  /* ported from homepage.html .case / .case-cover / .case-meta / .case-title /
     .case-summary, tokenized. The asymmetric lead slot is `.span-2`. */
  .case-card {
    display: flex;
    flex-direction: column;
  }
  .case-link {
    display: block;
    text-decoration: none;
  }
  .case-cover {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    overflow: hidden;
    background:
      radial-gradient(at 70% 30%, var(--cover-sheen-soft), transparent 50%),
      var(--case-cover);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .case-cover-image {
    width: 100%;
    height: 100%;
    /* Covers are authored at 16:10 — fit the whole composition and centre it,
       never crop. A warm mat covers any off-ratio cover cleanly. */
    object-fit: contain;
    object-position: center;
    background: var(--bg-secondary);
  }
  .case-card.span-2 .case-cover {
    aspect-ratio: 16 / 10;
  }
  .case-link:hover .case-cover,
  .case-link:focus-visible .case-cover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .case-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: var(--space-4) 0 var(--space-2);
  }
  .case-title {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-1);
    font-weight: 500;
  }
  .case-title a {
    color: var(--ink-primary);
    text-decoration: none;
  }
  .case-title a:hover {
    color: var(--accent);
  }
  .case-card.span-2 .case-title {
    font-size: 24px;
  }
  .case-summary {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-tertiary);
    max-width: 50ch;
    margin: 0;
  }
</style>
