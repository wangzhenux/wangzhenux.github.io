---
import ProductFrame from './ProductFrame.astro';

/**
 * Grid case card — the featured card's anatomy at grid scale: logo top-left,
 * tag pills top-right, short title + lead, bottom-cropped product shot in
 * device chrome. Hover floods the card with its `--card-brand` color and lifts
 * the shot (pointer devices only; reduced-motion respected). Cases without a
 * product shot fall back to their gradient/illustration cover.
 */
interface Props {
  slug: string;
  title: string;
  lead?: string;
  tags?: string[];
  brand?: string;
  logo?: string;
  logoAlt?: string;
  /** Optical size correction for wide/short lockups (default 1). */
  logoScale?: number;
  frame?: 'laptop' | 'browser';
  shot?: string;
  cover?: string;
  coverImage?: string;
  company?: string;
}
const {
  slug, title, lead, tags = [], brand, logo, logoAlt, logoScale,
  frame = 'browser', shot, cover, coverImage, company,
} = Astro.props;
const href = `/work/${slug}`;
---
<article class="case-card">
  <a class="ccard" href={href} aria-label={title} style={brand ? `--card-brand: ${brand}` : undefined}>
    <span class="ccard-hdr">
      {logo ? (
        <img class="ccard-logo" src={logo} alt={logoAlt ?? company ?? ''}
          style={logoScale ? `--logo-scale: ${logoScale}` : undefined} />
      ) : (
        <span class="ccard-co">{company}</span>
      )}
      {tags.length > 0 && (
        <span class="ccard-pills">{tags.map((t) => <span class="pill">{t}</span>)}</span>
      )}
    </span>
    <span class="ccard-title">{title}</span>
    {lead && <span class="ccard-lead">{lead}</span>}
    <span class="ccard-shot">
      {/* Hover fx — the Figma comp's two white 10% circles, scaled to this
          card's frame (see Featured.astro for the derivation + the
          synchronized lying-flat-to-standing-up rotateX treatment, where
          the two circles settle at different final tilts for depth). */}
      <i class="fx-c fx-c--big" aria-hidden="true"></i>
      <i class="fx-c fx-c--small" aria-hidden="true"></i>
      {shot ? (
        <ProductFrame src={shot} frame={frame} />
      ) : coverImage ? (
        <img class="ccard-cover-img" src={coverImage} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="ccard-cover" style={`--case-cover: ${cover}`} aria-hidden="true"></span>
      )}
    </span>
  </a>
</article>
<style>
  .case-card {
    display: flex;
    flex-direction: column;
  }
  .ccard {
    --card-brand: var(--bg-inverse);
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--bento-card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6) 0;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink-primary);
    transition: background 0.35s ease, border-color 0.35s ease;
  }
  /* Hover circles — the Figma comp's white 10% pair, converted to this
     card's frame width (90% of shot) and 16/7.5 shot aspect. */
  .ccard-shot .fx-c {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: color-mix(in srgb, var(--ink-on-dark) 10%, transparent);
  }
  /* Gently tipped-back at rest (a modest angle, not a near-90° sliver, so
     this stays a subtle companion to the frame's own 10px lift). Both stand
     up on the SAME schedule, settling at different final tilts (see hover
     rules below) so the pair reads as two planes at different depths. */
  .ccard-shot .fx-c--big {
    width: 141.29%;
    aspect-ratio: 1168 / 1125;
    top: -11.3%;
    transform: perspective(500px) rotateX(30deg) translateY(13px);
    transition:
      opacity 0.55s ease 0.08s,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
  }
  .ccard-shot .fx-c--small {
    width: 97.74%;
    aspect-ratio: 1;
    top: 16.31%;
    transform: perspective(500px) rotateX(30deg) translateY(16px);
    transition:
      opacity 0.55s ease 0.08s,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
  }
  /* Stacking: text above the fx circles that extend up past the shot area. */
  .ccard > * {
    position: relative;
    z-index: 1;
  }
  .ccard-hdr,
  .ccard-title,
  .ccard-lead {
    z-index: 2;
  }
  .ccard-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .ccard-logo {
    height: calc(18px * var(--logo-scale, 1));
    width: auto;
    filter: brightness(0);
    opacity: 0.85;
    transition: filter 0.35s ease, opacity 0.35s ease;
  }
  .ccard-co {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }
  .ccard-pills {
    display: flex;
    gap: var(--space-1);
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-secondary);
    background: var(--bg-primary);
    white-space: nowrap;
    transition: color 0.35s ease, border-color 0.35s ease, background 0.35s ease;
  }
  .ccard-title {
    display: block;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 500;
    margin-top: var(--space-4);
    transition: color 0.35s ease;
  }
  .ccard-lead {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-secondary);
    margin-top: var(--space-1);
    max-width: 52ch;
    transition: color 0.35s ease, opacity 0.35s ease;
  }
  /* Bottom-cropped shot area; fixed aspect keeps rows aligned across cards.
     Kept SHORTER than the shortest framed screenshot (widest aspect ~1.9 at 90%
     width) so every frame reaches the card's bottom edge and crops there —
     no cream gap breaking the illusion. */
  .ccard-shot {
    position: relative;
    margin-top: var(--space-5);
    aspect-ratio: 16 / 7.5;
  }
  .ccard-shot :global(.pframe) {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ccard-cover,
  .ccard-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .ccard-cover {
    background:
      radial-gradient(at 70% 30%, var(--cover-sheen-soft), transparent 50%),
      var(--case-cover);
  }
  .ccard-cover-img {
    object-fit: cover;
    object-position: center top;
  }

  @media (hover: hover) {
    .ccard:hover {
      background: var(--card-brand);
      border-color: var(--card-brand);
    }
    .ccard:hover .ccard-title,
    .ccard:hover .ccard-co {
      color: var(--ink-on-dark);
    }
    .ccard:hover .ccard-lead {
      color: var(--ink-on-dark);
      opacity: 0.82;
    }
    .ccard:hover .ccard-logo {
      filter: brightness(0) invert(1);
      opacity: 1;
    }
    .ccard:hover .pill {
      color: var(--ink-on-dark);
      border-color: color-mix(in srgb, var(--ink-on-dark) 40%, transparent);
      background: color-mix(in srgb, var(--ink-on-dark) 8%, transparent);
    }
    .ccard:hover .ccard-shot :global(.pframe) {
      transform: translateX(-50%) translateY(-10px);
    }
    .ccard:hover .fx-c--big {
      opacity: 1;
      transform: none;
    }
    .ccard:hover .fx-c--small {
      opacity: 1;
      transform: perspective(500px) rotateX(14deg);
    }
  }
  .ccard:focus-visible {
    background: var(--card-brand);
    border-color: var(--card-brand);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ccard:focus-visible .ccard-title,
  .ccard:focus-visible .ccard-co {
    color: var(--ink-on-dark);
  }
  .ccard:focus-visible .ccard-lead {
    color: var(--ink-on-dark);
    opacity: 0.82;
  }
  .ccard:focus-visible .ccard-logo {
    filter: brightness(0) invert(1);
    opacity: 1;
  }
  .ccard:focus-visible .pill {
    color: var(--ink-on-dark);
    border-color: color-mix(in srgb, var(--ink-on-dark) 40%, transparent);
    background: color-mix(in srgb, var(--ink-on-dark) 8%, transparent);
  }
  .ccard:focus-visible .fx-c--big {
    opacity: 1;
    transform: none;
  }
  .ccard:focus-visible .fx-c--small {
    opacity: 1;
    transform: perspective(500px) rotateX(14deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ccard,
    .ccard .pill,
    .ccard .ccard-logo,
    .ccard .ccard-title,
    .ccard .ccard-lead,
    .ccard .ccard-shot :global(.pframe),
    .ccard .fx-c {
      transition: none;
    }
    .ccard .fx-c {
      transform: none;
    }
    .ccard:hover .ccard-shot :global(.pframe) {
      transform: translateX(-50%);
    }
  }
</style>
