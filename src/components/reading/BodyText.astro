<div class="body-text"><slot /></div>
<style>
  /* ported from case-study-twilio.html .body-text, tokenized.
     Fills the body column for unified left+right edges.

     Block container (div, not p): MDX wraps a formatted paragraph — anything
     with **strong**, a link, etc. — in its own <p>, and a <p> can't nest in a
     <p> (the browser would split them into siblings, orphaning the content
     from this class and killing the <strong> marker below). A <div> lets that
     inner <p> nest validly so the descendant rules actually match. */
  .body-text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-secondary);
    max-width: none;
    margin: var(--space-5) 0;
  }
  /* Flatten MDX's inner paragraph(s): the wrapper owns the outer spacing, and
     stacked paragraphs breathe via the adjacent-sibling rule. */
  .body-text :global(p) { margin: 0; }
  .body-text :global(p + p) { margin-top: var(--space-4); }
  /* Marker-pen highlight on <strong> (§8.1). Default: thin amber underline.
     On hover: fills upward to a marker-style highlight. Reduced-motion is
     handled globally (kills the transition + shows the full marker). */
  .body-text :global(strong) {
    color: var(--ink-primary);
    font-weight: 500;
    background-image: linear-gradient(var(--highlight) 0%, var(--highlight) 100%);
    background-size: 100% 3px;
    background-position: 0 calc(100% - 1px);
    background-repeat: no-repeat;
    padding: 0 2px;
    transition: background-size 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .body-text :global(strong:hover) {
    background-size: 100% 88%;
  }
</style>
