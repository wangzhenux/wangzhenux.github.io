<div class="lede"><slot /></div>
<style>
  /* The opening paragraph of a case. It reads exactly like the body text that
     follows it (same face, size and line height); only its spacing differs.
     Block container (div, not p), same reason as BodyText: MDX wraps the slot
     in its own <p>, and a <p> inside a <p> gets split out of this class. */
  .lede {
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--ink-primary);
    max-width: none;
    margin: var(--space-10) 0 0;
    padding: 0;
  }
  .lede :global(p) { margin: 0; }
</style>
