---
interface Props {
  src: string;
  alt: string;
  caption: string;
  width?: number;
  height?: number;
}
const { src, alt, caption, width, height } = Astro.props;
---
<figure class="figure">
  <img
    class="figure-image"
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>
<style>
  /* ported from case-study-twilio.html .figure, tokenized.
     Body-column width (not full-bleed); monospace caption. */
  .figure {
    margin: var(--space-9) 0;
  }
  /* Show the figure at its natural ratio — never cropped. */
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }
  .figure-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-tertiary);
    line-height: 1.6;
  }
</style>
