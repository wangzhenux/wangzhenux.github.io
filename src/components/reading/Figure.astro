---
interface Props {
  src: string;
  alt: string;
  caption: string;
  width?: number;
  height?: number;
  /** Side-by-side layout: image on the left, caption on the right. */
  split?: boolean;
}
const { src, alt, caption, width, height, split = false } = Astro.props;
---
<figure class:list={['figure', { 'figure--split': split }]}>
  <img
    class="figure-image"
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>
<style>
  /* ported from case-study-twilio.html .figure, tokenized.
     Body-column width (not full-bleed); monospace caption. */
  .figure {
    margin: var(--space-9) 0;
  }
  /* Show the figure at its natural ratio — never cropped. */
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }
  .figure-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-tertiary);
    line-height: 1.6;
  }

  /* Split: image left, caption right, vertically centred. */
  .figure--split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
  }
  .figure--split .figure-image {
    margin-bottom: 0;
  }
  .figure--split .figure-caption {
    align-self: center;
  }
  @media (max-width: 767px) {
    .figure--split {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
