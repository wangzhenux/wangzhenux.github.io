<blockquote class="pullquote"><slot /></blockquote>
<style>
  /* ported from case-study-twilio.html .pullquote, tokenized.
     Left accent rail kept — pull quotes are typographic, not card chrome. */
  .pullquote {
    margin: var(--space-11) 0;
    max-width: 38ch;
    padding-left: 28px;
    border-left: 2px solid var(--accent);
    /* quote text styling applies whether the slot holds raw text or a <p> */
    font-family: var(--font-display);
    font-style: italic;
    font-size: 26px;
    line-height: 1.3;
    color: var(--ink-primary);
    letter-spacing: -0.012em;
  }
  .pullquote :global(p) {
    margin: 0 0 var(--space-3);
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
  .pullquote :global(cite) {
    display: block;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
</style>
