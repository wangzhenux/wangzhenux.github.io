---
interface Props { small?: boolean; }
const { small = false } = Astro.props;
---
{small ? (
  <h3 class="section-h section-h--small"><slot /></h3>
) : (
  <h2 class="section-h"><slot /></h2>
)}
<style>
  /* ported from case-study-twilio.html .section-h, tokenized.
     The 28px accent rule ::before is the ONE kept accent rule (typographic). */
  .section-h {
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--ink-primary);
    margin: var(--space-12) 0 var(--space-6);
    font-weight: 500;
    max-width: 22ch;
  }
  .section-h::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--accent);
    margin-bottom: var(--space-5);
  }
  .section-h--small {
    font-size: 22px;
    margin: var(--space-9) 0 var(--space-4);
  }
</style>
