---
/**
 * A closed-by-default disclosure for secondary detail (a how-it-works diagram,
 * an extra carousel), so the page reads short while the depth stays one click
 * away. Native <details>: keyboard-operable and complete without JS.
 * Token-only CSS.
 *
 *   <MoreDetail title="How a call goes, step by step"><StageFlow … /></MoreDetail>
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="md">
  <summary class="md-sum">
    <span class="md-title">{title}</span>
    <span class="md-chev" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </summary>
  <div class="md-body"><slot /></div>
</details>
<style>
  .md {
    margin: var(--space-7) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .md-sum {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    cursor: pointer;
  }
  .md-sum::-webkit-details-marker { display: none; }
  .md-sum:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .md-title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
    color: var(--ink-primary);
  }
  .md-chev {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-secondary);
    transition: transform 0.2s ease;
  }
  .md-chev svg { width: 16px; height: 16px; }
  .md-sum:hover .md-chev { color: var(--ink-primary); }
  .md[open] .md-chev { transform: rotate(180deg); }
  .md-body { padding-bottom: var(--space-4); }
  @media (prefers-reduced-motion: reduce) { .md-chev { transition: none; } }
</style>
