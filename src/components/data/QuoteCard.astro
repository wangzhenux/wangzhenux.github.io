---
interface Props { label: string; heading: string; }
const { label, heading } = Astro.props;
---
<div class="quote-card">
  <div class="quote-card-label">{label}</div>
  <h4>{heading}</h4>
  <p class="q"><slot /></p>
</div>
<style>
  /* ported from case-study-twilio.html .quote-card, tokenized.
     Mono accent label + display-serif h4 + italic quote (auto curly quotes). */
  .quote-card {
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-primary);
  }
  .quote-card-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-2);
  }
  .quote-card h4 {
    font-family: var(--font-display);
    font-size: 15px;
    margin: 0 0 var(--space-3);
    font-weight: 500;
    color: var(--ink-primary);
    line-height: 1.3;
  }
  .quote-card .q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-secondary);
    margin: 0;
  }
  .quote-card .q::before { content: '"'; }
  .quote-card .q::after { content: '"'; }
</style>
