---
interface Props { label: string; heading: string; quote: string; }
const { label, heading, quote } = Astro.props;
---
<div class="quote-card">
  <div class="quote-card-label">{label}</div>
  <h4>{heading}</h4>
  <p class="q">{quote}</p>
</div>
<style>
  /* ported from case-study-twilio.html .quote-card, tokenized.
     Mono accent label + display-serif h4 + display-serif quote with curly
     quotation marks (upright, no italic — matches the design system).
     The quote is a prop (not a slot) so the text renders directly inside .q;
     a Markdown slot would wrap the text in its own <p>, which is illegal
     inside <p class="q"> and would leave .q empty (just the quote marks). */
  .quote-card {
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-primary);
  }
  .quote-card-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-2);
  }
  .quote-card h4 {
    font-family: var(--font-display);
    font-size: 15px;
    margin: 0 0 var(--space-3);
    font-weight: 500;
    color: var(--ink-primary);
    line-height: 1.3;
  }
  .quote-card .q {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-secondary);
    margin: 0;
  }
  .quote-card .q::before { content: '\201C'; }
  .quote-card .q::after { content: '\201D'; }
</style>
