---
interface Props { num: string; label: string; }
const { num, label } = Astro.props;
---
<div class="stat">
  <div class="num">{num}</div>
  <div class="lab">{label}</div>
  <div class="desc"><slot /></div>
</div>
<style>
  /* ported from case-study-twilio.html .research-stats children, tokenized.
     The body slot holds the two-line bullet list as <span class="item"> rows;
     dash bullets are drawn with ::before. :global so slotted markup is styled. */
  .stat .num {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
    margin-bottom: var(--space-1);
    letter-spacing: -0.02em;
  }
  .stat .lab {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-1);
  }
  .stat .desc {
    font-size: 12px;
    color: var(--ink-secondary);
    line-height: 1.5;
  }
  .stat .desc :global(.item) {
    display: block;
    padding-left: var(--space-3);
    position: relative;
    margin-bottom: var(--space-1);
  }
  .stat .desc :global(.item:last-child) { margin-bottom: 0; }
  .stat .desc :global(.item::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 1px;
    background: var(--ink-quaternary);
  }
</style>
