---
interface MetaItem { k: string; v: string; }
interface Props { num: string; label: string; title: string; meta: MetaItem[]; }
const { num, label, title, meta } = Astro.props;
---
<div class="phase">
  <div class="phase-num">{num}</div>
  <div class="phase-content">
    <div class="phase-num-small">{label}</div>
    <h3 class="phase-title">{title}</h3>
    <div class="phase-text"><slot /></div>
    <dl class="phase-meta">
      {meta.map((m) => (
        <>
          <dt>{m.k}</dt>
          <dd>{m.v}</dd>
        </>
      ))}
    </dl>
  </div>
</div>
<style>
  /* ported from case-study-twilio.html .phase + .phase-meta, tokenized.
     Text-only (number + content + meta dl). The showcase image is placed by the
     page as a sibling .image-showcase block. Description prose comes via slot. */
  .phase {
    display: grid;
    grid-template-columns: 80px 1fr;
    column-gap: var(--space-6);
    /* Bottom padding separates the meta (audience/metric) from the phase's
       image-showcase, which follows as a sibling block. */
    padding: var(--space-9) 0 var(--space-6);
    align-items: start;
  }
  .phase-num {
    font-family: var(--font-display);
    font-size: var(--fs-num-lg);
    font-weight: 500;
    color: var(--accent);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .phase-num-small {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: var(--space-1);
  }
  .phase-title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    margin: 0 0 var(--space-2);
    font-weight: 500;
    line-height: var(--lh-title);
  }
  .phase-text {
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink-secondary);
    margin: 0 0 var(--space-4);
    max-width: 56ch;
  }
  /* slotted description may arrive as a bare <p> from MDX */
  .phase-text :global(p) {
    margin: 0;
    font: inherit;
    color: inherit;
  }
  /* Phase meta as a 2-column grid: mono labels left, body values right. */
  .phase-meta {
    display: grid;
    grid-template-columns: 96px 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-note);
    line-height: var(--lh-small);
    margin: 0;
  }
  .phase-meta dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding-top: var(--space-1);
  }
  .phase-meta dd {
    margin: 0;
    color: var(--ink-secondary);
  }

  /* Tighter first col on mobile (§9.1). The number keeps --fs-num-lg: the
     scale has no 48 tier, and 56 still fits the 64px column. */
  @media (max-width: 767px) {
    .phase { grid-template-columns: var(--space-11) 1fr; column-gap: var(--space-4); }
    .phase-meta { grid-template-columns: var(--space-12) 1fr; }
  }
</style>
