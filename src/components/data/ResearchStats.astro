---
interface Props { cols?: number; }
const { cols = 3 } = Astro.props;
---
<div class="research-stats" style={`--cols: ${cols}; --cols-phone: ${Math.min(cols, 2)}`}><slot /></div>
<style>
  /* ported from case-study-twilio.html .research-stats, tokenized.
     Column count is variable via --cols (default 3). */
  .research-stats {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--space-7);
    margin: var(--space-7) 0 var(--space-6);
    padding: var(--space-6);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
  }
  /* At most two columns on mobile, so 4- and 5-stat rows no longer widen the
     page. A lone last stat spans the row instead of leaving a half-empty one. */
  @media (max-width: 767px) {
    .research-stats { grid-template-columns: repeat(var(--cols-phone), 1fr); }
    .research-stats > :global(.stat:last-child:nth-child(odd)) { grid-column: 1 / -1; }
  }
</style>
