<div class="quote-row"><slot /></div>
<style>
  /* ported from case-study-twilio.html .quote-row, tokenized.
     Three quote cards side by side. */
  .quote-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }
  /* Cards stack on mobile (§9.1). */
  @media (max-width: 767px) {
    .quote-row { grid-template-columns: 1fr; }
  }
</style>
