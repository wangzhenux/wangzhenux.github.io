---
interface Props { num: string; title: string; }
const { num, title } = Astro.props;
---
<div class="pain-card">
  <div class="num">{num}</div>
  <h3>{title}</h3>
  <div class="pain-body"><slot /></div>
</div>
<style>
  /* ported from case-study-twilio.html .pain-card, tokenized.
     No chrome — large display-serif accent .num + h4 title + body. */
  .pain-card {
    padding: 0;
    background: transparent;
    border-radius: 0;
    border: none;
  }
  .pain-card .num {
    font-family: var(--font-display);
    font-size: var(--fs-num-sm);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-3);
  }
  .pain-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h6);
    margin: 0 0 var(--space-2);
    font-weight: 500;
    color: var(--ink-primary);
  }
  /* div, not p: MDX wraps the slot in its own <p>, which can't nest in a <p>. */
  .pain-card .pain-body {
    font-size: var(--fs-card);
    line-height: var(--lh-card);
    color: var(--ink-secondary);
    margin: 0;
  }
  .pain-body :global(p) { margin: 0; }
</style>
