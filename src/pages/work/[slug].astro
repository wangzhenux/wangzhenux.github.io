---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/chrome/Nav.astro';
import BackLink from '../../components/chrome/BackLink.astro';
import Footer from '../../components/chrome/Footer.astro';
import Hero from '../../components/hero/Hero.astro';
import BodyWrap from '../../components/layout/BodyWrap.astro';
import ProgressBar from '../../components/layout/ProgressBar.astro';
import NextCase from '../../components/showcase/NextCase.astro';
import CaseInteractions from '../../components/layout/CaseInteractions.astro';
import { getNext } from '../../lib/cases';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  // Hidden cases get no page at all (kept on disk for future restoration).
  return cases
    .filter((entry) => !entry.data.hidden)
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

// Eyebrow: "company · year · role", skipping any absent piece.
const eyebrow = [data.company, String(data.year), data.role]
  .filter(Boolean)
  .join(' · ');

// Standard meta strip across all cases: Team (role highlighted, team as the sub),
// Span, Type, Outcome — in that order (§11.1). A case may still supply an explicit
// `meta` array to override. Absent fields are omitted, so the order stays consistent.
const metaFields =
  data.meta && data.meta.length > 0
    ? data.meta
    : [
        data.role || data.team
          ? { label: 'Team', value: data.role ?? data.team!, sub: data.role ? data.team : undefined }
          : null,
        data.span || data.year ? { label: 'Span', value: data.span ?? String(data.year) } : null,
        data.type ? { label: 'Type', value: data.type } : null,
        data.outcome
          ? {
              label: 'Outcome',
              value: data.outcome.context
                ? `${data.outcome.metric} — ${data.outcome.context}`
                : data.outcome.metric,
            }
          : null,
      ].filter((f): f is { label: string; value: string; sub?: string } => f !== null);

// The case-page hero prefers a real product screenshot (heroImage) when present,
// falling back to the card cover. The homepage CaseCard still uses `cover`.
const cover = {
  caseCover: data.cover.gradient,
  image: data.heroImage ?? data.cover.image,
  width: data.heroWidth ?? data.cover.width,
  height: data.heroHeight ?? data.cover.height,
  alt: data.heroAlt ?? `${data.title} cover`,
};

const next = await getNext(data.slug);

const mainStyle = data.cover.gradient
  ? `--case-cover: ${data.cover.gradient}`
  : undefined;
---
<BaseLayout title={`${data.title} — Zhen Wang`} description={data.deck} ogType="article">
  <Nav currentPath={`/work/${data.slug}`} />
  <main id="main" tabindex="-1" style={mainStyle}>
    <ProgressBar sections={data.sections} />
    <BackLink href="/" />
    <Hero
      eyebrow={eyebrow}
      title={data.title}
      deck={data.deck}
      cover={cover}
      metaFields={metaFields}
    />
    <BodyWrap>
      <Content />
    </BodyWrap>
    {next && (
      <div class="next-case-wrap">
        <NextCase href={`/work/${next.data.slug}`} title={next.data.title} deck={next.data.deck} />
      </div>
    )}
  </main>
  <Footer />
  <CaseInteractions />
</BaseLayout>
<style>
  /* Bound the next-case footer link to the body column width. */
  .next-case-wrap {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 var(--pad-page-x);
  }
</style>
