---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/chrome/Nav.astro';
import Footer from '../../components/chrome/Footer.astro';
import WritingList from '../../components/home/WritingList.astro';
---
<BaseLayout
  title="Writing — Zhen Wang"
  description="Essays and notes by Zhen Wang on product design, developer experience, and the craft of building software."
>
  <Nav currentPath="/writing" />
  <main id="main" tabindex="-1">
    <header class="writing-hero">
      <h1 class="writing-hero-h1">Writing</h1>
      <p class="writing-hero-deck">
        Notes on design, front-end craft, and the work in between — published on Medium.
      </p>
    </header>

    <WritingList handle="wangzhen614" limit={20} title="All posts" />
  </main>
  <Footer />
</BaseLayout>
<style>
  .writing-hero {
    max-width: var(--max-content);
    margin-inline: auto;
    padding: var(--space-12) var(--pad-page-x) var(--space-9);
  }
  .writing-hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-4);
    font-weight: 500;
    color: var(--ink-primary);
  }
  .writing-hero-deck {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 56ch;
    margin: 0;
  }
  @media (max-width: 767px) {
    .writing-hero {
      padding: var(--space-11) var(--pad-page-x) var(--space-8);
    }
  }
</style>
