---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Seal from '../components/about/Seal.astro';
import CvCallout from '../components/about/CvCallout.astro';
import WorkHistory from '../components/about/WorkHistory.astro';
import EducationPractice from '../components/about/EducationPractice.astro';
import ReachMe from '../components/about/ReachMe.astro';

// Seal SVG is uploaded later; gate the real <img> on its presence and fall back
// to a styled "Z" wordmark otherwise (§15.4 / Task 7.2).
const hasSeal = Object.keys(import.meta.glob('/public/seal.svg')).length > 0;

// Real work history, grouped by company, most recent first. Titles are verbatim
// from prior roles; the two Tasktop roles are combined into one entry. Dates are
// intentionally omitted (they live in the PDF résumé). `logo` is added once the
// file lands in /public/logos — the component shows text only until then.
const companies = [
  { company: 'Tripalink', title: 'Founding Product Designer', logo: '/tripalink/Logo.png' },
  { company: 'Twilio', title: 'Senior Product Designer', logo: '/twilio/Twilio-logo-red.png' },
  { company: 'Tasktop', title: 'Design Lead · Senior UX Designer', logo: '/tasktop/tasktop_logo.png' },
  { company: 'Rackspace', title: 'Senior Designer', logo: '/rackspace/rackspace-logo.png' },
];

// Education: confirmed by Zhen. Two real degrees, formatted degree ·
// institution · year. No GPAs, honors, or dates beyond the two years given.
const education = [
  { primary: 'MS, Information Studies', detail: 'University of Texas at Austin · 2016', logo: '/logos/ut-austin.svg' },
  { primary: 'BS, Computer Engineering', detail: 'University of Nebraska–Lincoln · 2014', logo: '/logos/nebraska.svg' },
];
---
<BaseLayout
  title="About — Zhen Wang"
  description="About Zhen Wang — senior product designer. Background, work history, and how to get in touch."
>
  <Nav currentPath="/about" />
  <main id="main" tabindex="-1">
    <header class="hero">
      <div class="hero-text">
        <p class="hero-eyebrow">About · Curriculum vitae</p>
        <h1 class="hero-h1">Hi, I'm Zhen.</h1>
        <p class="hero-bio">
          I'm a user experience designer and developer with a passion for making
          things functional and intuitive to use. A background in computer
          engineering with a focus on front-end development lets me hold both
          sides of a problem at once — the visual and the technical — which has
          been useful across the kind of dense, expert software I've spent most
          of my career on.
        </p>
        <p class="hero-bio">
          Outside work I like to travel and play sports, especially table tennis
          and badminton. I also love traditional Chinese calligraphy and
          painting — the slow stuff balances out the screens.
        </p>
      </div>
      <div class="hero-seal">
        <Seal hasSeal={hasSeal} />
      </div>
    </header>

    <CvCallout lastUpdated="June 2026" />
    <WorkHistory companies={companies} />
    <EducationPractice education={education} />
    <ReachMe />
  </main>
  <Footer />
</BaseLayout>
<style>
  /* ported from about-resume.html .hero, tokenized */
  .hero {
    padding: var(--space-13) var(--pad-page-x) var(--space-12);
    max-width: var(--max-content);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-tertiary);
    margin: 0 0 var(--space-4);
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-5);
    font-weight: 500;
    max-width: 14ch;
  }
  .hero-bio {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-secondary);
    margin: 0 0 var(--space-4);
    max-width: 56ch;
  }
  .hero-bio:last-of-type {
    margin-bottom: 0;
  }
  .hero-seal {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    background: linear-gradient(135deg, var(--accent-soft), transparent), var(--bg-secondary);
    border-radius: 6px;
  }
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      padding: var(--space-11) var(--pad-page-x) var(--space-10);
      gap: var(--space-7);
    }
    .hero-seal {
      aspect-ratio: auto;
      padding: var(--space-9) 0;
      order: -1;
    }
  }
</style>
