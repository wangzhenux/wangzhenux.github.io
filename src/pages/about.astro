---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import CvCallout from '../components/about/CvCallout.astro';
import WorkHistory from '../components/about/WorkHistory.astro';
import EducationPractice from '../components/about/EducationPractice.astro';
import ReachMe from '../components/about/ReachMe.astro';

// Real work history, grouped by company, most recent first. Titles are verbatim
// from prior roles; the two Tasktop roles are combined into one entry. Dates are
// intentionally omitted (they live in the PDF résumé). `logo` is added once the
// file lands in /public/logos — the component shows text only until then.
const companies = [
  { company: 'Tripalink', title: 'Lead Product Designer', logo: '/tripalink/Logo.png' },
  { company: 'Twilio', title: 'Product Designer', logo: '/twilio/Twilio-logo-red.png' },
  { company: 'Tasktop', title: 'Senior UX Designer', logo: '/tasktop/tasktop_logo.png' },
  // Rackspace's mark is a white knockout, so it needs an ink treatment to read
  // on cream; the others keep their real brand colors.
  { company: 'Rackspace', title: 'UX Designer', logo: '/rackspace/rackspace-logo.png', logoDark: true, logoScale: 1.25 },
];

// Education: confirmed by Zhen. Two real degrees, formatted degree ·
// institution · year. No GPAs, honors, or dates beyond the two years given.
const education = [
  // UT Austin's shield stacks taller than Nebraska's wordmark, so trim it a
  // touch to level the two visually.
  { primary: 'MS, Information Studies', detail: 'University of Texas at Austin · 2016', logo: '/logos/ut-austin.svg', logoScale: 0.86 },
  { primary: 'BS, Computer Engineering', detail: 'University of Nebraska–Lincoln · 2014', logo: '/logos/nebraska.svg' },
];
---
<BaseLayout
  title="About — Zhen Wang"
  description="About Zhen Wang — senior product designer. Background, work history, and how to get in touch."
>
  <Nav currentPath="/about" />
  <main id="main" tabindex="-1">
    <header class="hero">
      <div class="hero-text">
        <p class="hero-eyebrow">About · Curriculum vitae</p>
        <h1 class="hero-h1">Hi, I'm Zhen.</h1>
        <p class="hero-bio">
          I'm a product designer and developer, and I like
          <strong class="highlight">making dense, complicated software feel simple</strong>.
          I studied computer engineering and still write front-end code, so I can
          <strong class="highlight">hold both sides of a problem</strong> — the visual
          and the technical. That's helped across the expert software I've built
          over the past decade.
        </p>
        <p class="hero-bio">
          Outside work I travel and play a lot of table tennis and badminton. I
          also do Chinese calligraphy and painting — the slow stuff balances out
          the screens.
        </p>
      </div>
      <div class="hero-portrait">
        <img
          src="/about/portrait.png"
          alt="A line-art portrait of Zhen Wang, resting his chin on his hand"
          width="1200"
          height="1200"
          loading="eager"
          decoding="async"
        />
      </div>
    </header>

    <CvCallout lastUpdated="July 2026" />
    <WorkHistory companies={companies} />
    <EducationPractice education={education} />
    <ReachMe />
  </main>
  <Footer />
</BaseLayout>
<style>
  /* ported from about-resume.html .hero, tokenized */
  .hero {
    padding: var(--space-13) var(--pad-page-x) var(--space-12);
    max-width: var(--max-content);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-tertiary);
    margin: 0 0 var(--space-4);
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-5);
    font-weight: 500;
    max-width: 14ch;
  }
  .hero-bio {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-secondary);
    margin: 0 0 var(--space-4);
    max-width: 56ch;
  }
  .hero-bio:last-of-type {
    margin-bottom: 0;
  }
  /* Line-art portrait on a transparent ground — no frame or background, so the
     illustration sits directly on the page. */
  .hero-portrait {
    aspect-ratio: 1 / 1;
  }
  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      padding: var(--space-11) var(--pad-page-x) var(--space-10);
      gap: var(--space-7);
    }
    .hero-portrait {
      order: -1;
      max-width: 300px;
      margin-inline: auto;
    }
  }
</style>
