---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Featured from '../components/home/Featured.astro';
import SelectedGrid from '../components/home/SelectedGrid.astro';
import WritingList from '../components/home/WritingList.astro';
import Archive from '../components/home/Archive.astro';
import { getFeatured, getSelected, getArchive } from '../lib/cases';
import type { CaseEntry } from '../lib/cases';

const featured = await getFeatured();
const selected = await getSelected();
const archive = await getArchive();

/** Map a case collection entry to the home-component card shape. */
function toCard(c: CaseEntry) {
  return {
    slug: c.data.slug,
    title: c.data.title,
    company: c.data.company,
    year: c.data.year,
    role: c.data.role,
    cover: c.data.cover.gradient,
    image: c.data.cover.image,
    summary: c.data.deck,
  };
}

const featuredMeta = featured
  ? [
      { label: 'Role', value: featured.data.role },
      featured.data.team ? { label: 'Team', value: featured.data.team } : null,
      featured.data.span ? { label: 'Span', value: featured.data.span } : null,
      featured.data.outcome ? { label: 'Outcome', value: featured.data.outcome.metric } : null,
    ].filter((f): f is { label: string; value: string } => f !== null)
  : [];

const selectedCards = selected.map(toCard);
const archiveItems = archive.map((c) => ({
  slug: c.data.slug,
  title: c.data.title,
  year: c.data.year,
}));
---
<BaseLayout title="Zhen Wang — Senior Product Designer">
  <Nav currentPath="/" />
  <main id="main" tabindex="-1">
    <header class="home-hero">
      <p class="home-hero-eyebrow">Senior Product Designer</p>
      <h1 class="home-hero-h1">
        Hi, I'm Zhen, a senior product designer who likes quiet, useful software.
      </h1>
      <p class="home-hero-sub">
        Ten years at Twilio, Tasktop, and Rackspace. Outside work: badminton,
        ping-pong, calligraphy, and painting.
      </p>
    </header>

    {featured && (
      <Featured
        slug={featured.data.slug}
        title={featured.data.title}
        company={featured.data.company}
        year={featured.data.year}
        cover={featured.data.cover.gradient}
        image={featured.data.cover.image}
        summary={featured.data.deck}
        metaFields={featuredMeta}
      />
    )}

    <SelectedGrid cases={selectedCards} />

    <WritingList />

    <Archive items={archiveItems} />
  </main>
  <Footer />
</BaseLayout>
<style>
  /* Homepage hero (§6.1 item 2): eyebrow + F2 copy, reading column ~720px. */
  .home-hero {
    max-width: 720px;
    padding: var(--space-12) var(--pad-page-x) var(--space-11);
  }
  .home-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-tertiary);
    margin: 0 0 var(--space-4);
  }
  .home-hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-5);
    font-weight: 500;
    color: var(--ink-primary);
    max-width: 18ch;
  }
  .home-hero-sub {
    font-size: 17px;
    line-height: 1.6;
    max-width: 580px;
    color: var(--ink-secondary);
    margin: 0;
  }
</style>
