---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Featured from '../components/home/Featured.astro';
import SelectedGrid from '../components/home/SelectedGrid.astro';
import WritingList from '../components/home/WritingList.astro';
import Archive from '../components/home/Archive.astro';
import Container from '../components/layout/Container.astro';
import Icon from '../components/chrome/Icon.astro';
import { getFeatured, getSelected, getArchive } from '../lib/cases';
import type { CaseEntry } from '../lib/cases';

const featured = await getFeatured();
const selected = await getSelected();
const archive = await getArchive();

/** Map a case collection entry to the home card shape: short card copy (with
 *  title/deck fallbacks), tag pills, brand flood color, logo, and the framed
 *  product shot (falls back to heroImage, then the legacy gradient cover). */
function toCard(c: CaseEntry) {
  const card = c.data.card ?? {};
  return {
    slug: c.data.slug,
    title: card.title ?? c.data.title,
    lead: card.lead ?? c.data.deck,
    tags: card.tags,
    brand: card.brand,
    logo: card.logo,
    logoAlt: card.logoAlt ?? c.data.company,
    logoScale: card.logoScale,
    frame: card.frame,
    shot: card.shot ?? c.data.heroImage,
    cover: c.data.cover.gradient,
    coverImage: c.data.cover.image,
    company: c.data.company,
  };
}

const selectedCards = selected.map(toCard);
const archiveItems = archive.map((c) => ({
  slug: c.data.slug,
  title: c.data.title,
  year: c.data.year,
}));
---
<BaseLayout
  title="Zhen Wang — Senior Product Designer"
  description="Senior product designer working on developer and enterprise tools. Selected case studies from Twilio, Tasktop, and Rackspace, plus writing and an archive."
>
  <Nav currentPath="/" />
  <main id="main" tabindex="-1">
    <header class="home-hero">
      <Container>
        <div class="home-hero-inner">
          <div class="home-hero-text">
            <h1 class="home-hero-h1">Hello,<br />I'm Zhen.</h1>
            <div class="home-hero-facts">
              <p>Product designer with <strong>10+ years of experience</strong></p>
              <p>Currently <strong>Product Design Lead</strong> at Tripalink</p>
              <p>Shipping AI-native products for fast-growing teams</p>
            </div>
            <div class="home-hero-actions">
              <a class="btn btn-primary" href="mailto:wangzhen614@gmail.com">
                Contact<Icon name="arrow-up-right" size={14} />
              </a>
              <a
                class="home-hero-linkedin"
                href="https://www.linkedin.com/in/zhenwang614"
                target="_blank"
                rel="noopener"
                aria-label="LinkedIn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <rect x="4" y="9" width="3.5" height="11" rx="1" />
                  <circle cx="5.75" cy="4.5" r="2.25" />
                  <path d="M11.5 9h3.3v1.9h.05c.46-.87 1.6-1.9 3.3-1.9 3.5 0 4.15 2.3 4.15 5.3V20h-3.5v-6.1c0-1.45-.03-3.3-2.02-3.3-2.03 0-2.34 1.58-2.34 3.2V20h-3.5V9z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="home-hero-portrait">
            <img
              src="/about/portrait.png"
              alt="A line-art portrait of Zhen Wang, resting his chin on his hand"
              width="1200"
              height="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </Container>
    </header>

    {featured && <Featured {...toCard(featured)} frame={featured.data.card?.frame ?? 'laptop'} />}

    <SelectedGrid cases={selectedCards} />

    <WritingList />

    <Archive items={archiveItems} />
  </main>
  <Footer />
</BaseLayout>
<style>
  /* Homepage hero (§6.1 item 2): eyebrow + F2 copy. Content sits in the shared
     Container (max-content, centered, page gutter) so its left edge aligns with
     the nav and every section below; the section itself carries only vertical
     rhythm. The text keeps a tighter reading column via the inner max-widths. */
  /* Full-height hero: fills the viewport below the nav so the featured work
     starts just below the fold. Text and portrait sit side by side, centered. */
  /* Grid (not flex) so the inner Container stays full-width and its margin-auto
     content frame keeps the shared left edge; align-content centers vertically. */
  .home-hero {
    min-height: calc(100svh - 64px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    padding-block: var(--space-9);
  }
  /* As a grid item, the Container's margin-inline:auto would shrink it to its
     content and re-center — shifting the left edge off the shared frame. An
     explicit full width keeps it stretching to max-content like every other
     section, so the content edge stays aligned. */
  .home-hero > :global(.container) {
    width: 100%;
  }
  .home-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-10);
    width: 100%;
  }
  .home-hero-portrait {
    aspect-ratio: 1 / 1;
    max-width: 560px;
    margin-left: auto;
  }
  .home-hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .home-hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 var(--space-6);
    font-weight: 500;
    color: var(--ink-primary);
  }
  .home-hero-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .home-hero-facts p {
    font-size: 17px;
    line-height: 1.5;
    max-width: 580px;
    color: var(--ink-secondary);
    margin: 0;
  }
  .home-hero-facts strong {
    color: var(--ink-primary);
    font-weight: 600;
  }
  .home-hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  /* Same .btn/.btn-primary treatment as the About page's resume CTA
     (CvCallout.astro) — repeated here since Astro scopes styles per file.
     Explicit height (rather than letting padding drive it) so the square
     LinkedIn icon button next to it can match exactly. */
  .btn {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: opacity 0.2s, background 0.2s, color 0.2s;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--ink-on-dark);
  }
  .btn-primary:hover,
  .btn-primary:focus-visible {
    opacity: 0.92;
  }
  .home-hero-linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--ink-primary);
    color: var(--ink-primary);
    flex-shrink: 0;
    transition: background 0.2s, color 0.2s;
  }
  .home-hero-linkedin:hover,
  .home-hero-linkedin:focus-visible {
    background: var(--ink-primary);
    color: var(--bg-primary);
  }
  @media (max-width: 767px) {
    .home-hero {
      min-height: 0;
      padding-block: var(--space-11) var(--space-10);
    }
    .home-hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .home-hero-portrait {
      order: -1;
      max-width: 280px;
      margin-inline: auto;
    }
  }
</style>
