---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Featured from '../components/home/Featured.astro';
import SelectedGrid from '../components/home/SelectedGrid.astro';
import WritingList from '../components/home/WritingList.astro';
import Archive from '../components/home/Archive.astro';
import SpecimenHero from '../components/home/SpecimenHero.astro';
import { getFeatured, getSelected, getArchive, toCard } from '../lib/cases';

const featured = await getFeatured();
const selected = await getSelected();
const archive = await getArchive();

const selectedCards = selected.map(toCard);
const archiveItems = archive.map((c) => ({
  slug: c.data.slug,
  title: c.data.title,
  year: c.data.year,
}));
---
<BaseLayout
  title="Zhen Wang — Product Designer"
  description="Senior product designer working on developer and enterprise tools. Selected case studies from Twilio, Tasktop, and Rackspace, plus writing and an archive."
>
  <Nav currentPath="/" />
  <main id="main" tabindex="-1">
    <SpecimenHero />

    <div id="selected-work" tabindex="-1">
      {featured && <Featured {...toCard(featured)} frame={featured.data.card?.frame ?? 'laptop'} />}
      <SelectedGrid cases={selectedCards} />
    </div>

    <WritingList />

    <Archive items={archiveItems} />
  </main>
  <Footer />
</BaseLayout>
